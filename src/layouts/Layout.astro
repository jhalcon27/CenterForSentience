---
/*
 * Native Astro i18n implementation using getRelativeLocaleUrl
 * Signature: getRelativeLocaleUrl(locale: string, path: string)
 * Used to ensure locale-aware path construction.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
const { lang = 'en' } = Astro.props;
---
<nav>
  <a href={getRelativeLocaleUrl(lang, 'research')}>Research</a>
  <a href={getRelativeLocaleUrl(lang, 'reports')}>Reports</a>
  <a href={getRelativeLocaleUrl(lang, 'about')}>About</a>
  <a href={getRelativeLocaleUrl(lang, 'resources')}>Resources</a>
  <a href={getRelativeLocaleUrl(lang, 'donate')}>Donate</a>
</nav>
<slot />
