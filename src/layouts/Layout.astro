---
import Search from '../components/Search.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import LanguageRedirect from '../components/LanguageRedirect.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "The Center for Sentience Research (CSR) is a Swiss-based non-profit dedicated to modeling the physical foundations of awareness across all substrates.",
  image = "/images/og-main.jpg",
} = Astro.props;

// Use Astro.currentLocale as the single source of truth, default to 'en'
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
const siteURL = "https://centerforsentience.org";
const fullTitle = `${title} | Center for Sentience Research`;

// Helper for ALL internal links
const localizedHref = (path: string) => `${prefix}${path === '/' ? '' : path}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <LanguageRedirect />
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="3a41742e-2fde-44af-b8a6-96094c47a90f"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-csr-bg text-csr-fg">
    <nav class="sticky top-0 z-50 bg-csr-bg/80 backdrop-blur-md border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href={localizedHref("/")} class="flex items-center gap-2">
            <div class="w-10 h-10 rounded bg-[#9966CC] flex items-center justify-center text-white font-bold text-xl">C</div>
            <div class="flex flex-col">
              <span class="font-bold text-lg text-black">Center for Sentience</span>
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#9966CC]">Research Institute</span>
            </div>
        </a>
        <div class="flex items-center gap-4">
            <a href={localizedHref("/research")} class="text-sm font-medium hover:text-[#9966CC]">Research</a>
            <a href={localizedHref("/reports")} class="text-sm font-medium hover:text-[#9966CC]">Reports</a>
            <a href={localizedHref("/about")} class="text-sm font-medium hover:text-[#9966CC]">About</a>
            <a href={localizedHref("/donate")} class="bg-[#9966CC] text-white px-4 py-2 rounded-full text-sm font-medium">Support</a>
            <Search />
            <LanguageSwitcher lang={lang} />
        </div>
      </div>
    </nav>
    <main class="flex-grow"><slot /></main>
  </body>
</html>
