---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Search from '../components/Search.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import '../styles/global.css';
import { useTranslations } from '../i18n/index';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const {
  title,
  description = "The Center for Sentience Research (CSR) is an independent research project reproducing mechanistic interpretability results and studying internal model states.",
  image = "/images/og-main.jpg",
  lang = "en",
} = Astro.props;

const currentLang = Astro.currentLocale ?? lang;
const fullTitle = `${title} | Center for Sentience Research`;
const t = useTranslations(currentLang as any);

const pathname = Astro.url.pathname;
const isActive = (route: string) => {
  const segments = pathname.split('/').filter(Boolean);
  return segments.includes(route);
};

// Absolute URLs for canonical / social meta
const canonicalURL = new URL(pathname, Astro.site);
const socialImage = new URL(image, Astro.site);

// hreflang alternates: strip the locale prefix, then emit alternates
const allLocales = ['en', 'de', 'es', 'fr', 'zh', 'ja'];
const localizedRoutes = [
  '',
  'research',
  'reports',
  'about',
  'contact',
  'reports/first-principles',
  'reports/bio-electric-fields',
  'reports/assembly-theory',
  'reports/symmetry-landscapes',
];

let rawPath = pathname;
for (const loc of allLocales.slice(1)) {
  if (rawPath.startsWith(`/${loc}/`)) { rawPath = rawPath.slice(loc.length + 1); break; }
  if (rawPath === `/${loc}` || rawPath === `/${loc}/`) { rawPath = '/'; break; }
}

const cleanPath = rawPath.replace(/^\/+/, '').replace(/\/+$/, '');
const isEnglishOnly = cleanPath === 'reproductions' || cleanPath.startsWith('reproductions/');

const alternates = isEnglishOnly
  ? [
      { hreflang: 'en', href: new URL(pathname, Astro.site) },
      { hreflang: 'x-default', href: new URL(pathname, Astro.site) },
    ]
  : localizedRoutes.includes(cleanPath)
    ? [
        ...allLocales.map((loc) => ({ hreflang: loc, href: new URL(getRelativeLocaleUrl(loc, cleanPath || '/'), Astro.site) })),
        { hreflang: 'x-default', href: new URL(getRelativeLocaleUrl('en', cleanPath || '/'), Astro.site) },
      ]
    : [];

const ogLocales: Record<string, string> = { en: 'en_US', de: 'de_DE', es: 'es_ES', fr: 'fr_FR', zh: 'zh_CN', ja: 'ja_JP' };
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloud.umami.is https://api-gateway.umami.dev https://formspree.io; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Center for Sentience Research" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={ogLocales[currentLang] ?? 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="3a41742e-2fde-44af-b8a6-96094c47a90f"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-csr-cream">

    <!-- Navigation -->
    <nav class="sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">

        <!-- Logo -->
        <a href={getRelativeLocaleUrl(currentLang, '/')} class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-lg bg-csr-primary flex items-center justify-center shrink-0 shadow-purple/40 shadow-md group-hover:bg-csr-primary-dark transition-colors">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="10" cy="10" r="3" fill="white" opacity="0.9"/>
              <path d="M10 3 C6.13 3 3 6.13 3 10 C3 13.87 6.13 17 10 17" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
              <path d="M10 6 C8.07 6 6.5 7.57 6.5 9.5 C6.5 11.43 8.07 13 10 13 C11.93 13 13.5 11.43 13.5 9.5" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
              <path d="M14 5 L16 3 M16 3 L14 3 M16 3 L16 5" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
            </svg>
          </div>
          <div class="flex flex-col leading-none">
            <span class="font-bold text-base text-csr-black tracking-tight">Center for Sentience Research</span>
          </div>
        </a>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 text-csr-gray-500 hover:text-csr-black rounded-lg hover:bg-csr-gray-100 transition-colors" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Desktop nav: Reproductions · Research · Working papers · About · Contact -->
        <div class="hidden md:flex items-center gap-1">
          <a href="/reproductions/" class={`px-3 py-2 text-sm font-medium rounded-lg transition-all ${isActive('reproductions') ? 'text-csr-primary bg-csr-primary/8 font-semibold' : 'text-csr-gray-600 hover:text-csr-black hover:bg-csr-gray-100'}`}>{t('nav.reproductions')}</a>
          <a href={getRelativeLocaleUrl(currentLang, 'research')} class={`px-3 py-2 text-sm font-medium rounded-lg transition-all ${isActive('research') ? 'text-csr-primary bg-csr-primary/8 font-semibold' : 'text-csr-gray-600 hover:text-csr-black hover:bg-csr-gray-100'}`}>{t('nav.research')}</a>
          <a href={getRelativeLocaleUrl(currentLang, 'reports')} class={`px-3 py-2 text-sm font-medium rounded-lg transition-all ${isActive('reports') ? 'text-csr-primary bg-csr-primary/8 font-semibold' : 'text-csr-gray-600 hover:text-csr-black hover:bg-csr-gray-100'}`}>{t('nav.reports')}</a>
          <a href={getRelativeLocaleUrl(currentLang, 'about')} class={`px-3 py-2 text-sm font-medium rounded-lg transition-all ${isActive('about') ? 'text-csr-primary bg-csr-primary/8 font-semibold' : 'text-csr-gray-600 hover:text-csr-black hover:bg-csr-gray-100'}`}>{t('nav.about')}</a>
          <a href={getRelativeLocaleUrl(currentLang, 'contact')} class={`px-3 py-2 text-sm font-medium rounded-lg transition-all ${isActive('contact') ? 'text-csr-primary bg-csr-primary/8 font-semibold' : 'text-csr-gray-600 hover:text-csr-black hover:bg-csr-gray-100'}`}>{t('nav.contact')}</a>
          <div class="w-px h-5 bg-csr-gray-200 mx-2"></div>
          <Search lang={currentLang} />
          <LanguageSwitcher lang={currentLang} />
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-csr-gray-200 bg-csr-cream">
        <div class="px-4 py-4 flex flex-col gap-1">
          <a href="/reproductions/" class={`px-3 py-2.5 text-sm font-medium rounded-lg transition-all ${isActive('reproductions') ? 'text-csr-primary bg-csr-primary/8 font-semibold' : 'text-csr-gray-600 hover:text-csr-black hover:bg-csr-gray-100'}`}>{t('nav.reproductions')}</a>
          <a href={getRelativeLocaleUrl(currentLang, 'research')} class={`px-3 py-2.5 text-sm font-medium rounded-lg transition-all ${isActive('research') ? 'text-csr-primary bg-csr-primary/8 font-semibold' : 'text-csr-gray-600 hover:text-csr-black hover:bg-csr-gray-100'}`}>{t('nav.research')}</a>
          <a href={getRelativeLocaleUrl(currentLang, 'reports')} class={`px-3 py-2.5 text-sm font-medium rounded-lg transition-all ${isActive('reports') ? 'text-csr-primary bg-csr-primary/8 font-semibold' : 'text-csr-gray-600 hover:text-csr-black hover:bg-csr-gray-100'}`}>{t('nav.reports')}</a>
          <a href={getRelativeLocaleUrl(currentLang, 'about')} class={`px-3 py-2.5 text-sm font-medium rounded-lg transition-all ${isActive('about') ? 'text-csr-primary bg-csr-primary/8 font-semibold' : 'text-csr-gray-600 hover:text-csr-black hover:bg-csr-gray-100'}`}>{t('nav.about')}</a>
          <a href={getRelativeLocaleUrl(currentLang, 'contact')} class={`px-3 py-2.5 text-sm font-medium rounded-lg transition-all ${isActive('contact') ? 'text-csr-primary bg-csr-primary/8 font-semibold' : 'text-csr-gray-600 hover:text-csr-black hover:bg-csr-gray-100'}`}>{t('nav.contact')}</a>
          <div class="flex items-center justify-between pt-3 border-t border-csr-gray-200 mt-2">
            <Search lang={currentLang} />
            <LanguageSwitcher lang={currentLang} />
          </div>
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-csr-gray-200 bg-csr-cream">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded bg-csr-primary flex items-center justify-center shrink-0">
            <svg width="12" height="12" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="10" cy="10" r="3" fill="white" opacity="0.9"/>
              <path d="M10 3 C6.13 3 3 6.13 3 10 C3 13.87 6.13 17 10 17" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
            </svg>
          </div>
          <span class="text-sm font-semibold text-csr-black">{t('footer.org')}</span>
          <span class="text-csr-gray-300 hidden sm:inline">·</span>
          <span class="text-sm text-csr-gray-500 hidden sm:inline">{t('footer.hq')}</span>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-csr-gray-500">
          <a href={getRelativeLocaleUrl(currentLang, 'contact')} class="hover:text-csr-primary transition-colors">{t('nav.contact')}</a>
          <span class="text-csr-gray-300">·</span>
          <p class="text-csr-gray-400">{t('footer.copyright')}</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          const isOpen = !menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(isOpen));
        });
      }
    </script>
  </body>
</html>
