---
import Search from '../components/Search.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import LanguageRedirect from '../components/LanguageRedirect.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const {
  title,
  description = "The Center for Sentience Research (CSR) is a Swiss-based non-profit dedicated to modeling the physical foundations of awareness across all substrates.",
  image = "/images/og-main.jpg",
  lang = "en",
} = Astro.props;

const siteURL = "https://centerforsentience.org";
const fullTitle = `${title} | Center for Sentience Research`;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <LanguageRedirect />
    
    <!-- Amethyst Palette Variables -->
    <style is:global>
      :root {
        --csr-white: #FFF8F0;
        --csr-black: #0f172a;
        --csr-gray-50: #fefcf5;
        --csr-gray-100: #f4eee2;
        --csr-gray-200: #e8e0d0;
        --csr-gray-600: #475569;
        --csr-primary: #9966CC;
        --csr-primary-dark: #7a4bb0;
        --csr-primary-light: #b48de0;
      }
      
      body {
        background-color: var(--csr-white);
        color: var(--csr-black);
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.6;
      }

      .bg-white { background-color: #FFF8F0 !important; }
      
      .text-gradient {
        background: linear-gradient(135deg, var(--csr-primary), var(--csr-primary-dark));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .glass-card {
        background: rgba(255, 248, 240, 0.8);
        backdrop-filter: blur(8px);
        border: 1px solid var(--csr-gray-200);
      }
    </style>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <!-- Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="3a41742e-2fde-44af-b8a6-96094c47a90f"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#FFF8F0]">
    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-[#FFF8F0]/80 backdrop-blur-md border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
            <div class="w-10 h-10 rounded bg-[#9966CC] flex items-center justify-center text-white font-bold text-xl">C</div>
            <div class="flex flex-col">
              <span class="font-bold text-lg text-black">Center for Sentience</span>
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#9966CC]">Research Institute</span>
            </div>
        </a>
        <div class="flex items-center gap-4">
            <a href={prefix + "/research"} class="text-sm font-medium hover:text-[#9966CC]">Research</a>
            <a href={prefix + "/reports"} class="text-sm font-medium hover:text-[#9966CC]">Reports</a>
            <a href={prefix + "/about"} class="text-sm font-medium hover:text-[#9966CC]">About</a>
            <a href={prefix + "/donate"} class="bg-[#9966CC] text-white px-4 py-2 rounded-full text-sm font-medium">Support</a>
            <Search />
            <LanguageSwitcher lang={lang} />
        </div>
      </div>
    </nav>
    <main class="flex-grow"><slot /></main>
  </body>
</html>
