---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Search from '../components/Search.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import LanguageRedirect from '../components/LanguageRedirect.astro';
import '../styles/global.css';
import { useTranslations } from '../i18n/index';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const {
  title,
  description = "The Center for Sentience Research (CSR) is a Swiss-based non-profit dedicated to modeling the physical foundations of awareness across all substrates.",
  image = "/images/og-main.jpg",
  lang = "en",
} = Astro.props;

const currentLang = Astro.currentLocale ?? lang;
const fullTitle = `${title} | Center for Sentience Research`;
const t = useTranslations(currentLang as any);
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <LanguageRedirect />
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="3a41742e-2fde-44af-b8a6-96094c47a90f"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#FFF8F0]">
    <nav class="sticky top-0 z-50 bg-[#FFF8F0]/80 backdrop-blur-md border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href={getRelativeLocaleUrl(currentLang, '/')} class="flex items-center gap-2">
            <div class="w-10 h-10 rounded bg-[#9966CC] flex items-center justify-center text-white font-bold text-xl">C</div>
            <div class="flex flex-col">
              <span class="font-bold text-lg text-black">Center for Sentience</span>
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#9966CC]">Research Institute</span>
            </div>
        </a>
        <div class="flex items-center gap-4">
            <a href={getRelativeLocaleUrl(currentLang, 'research')} class="text-sm font-medium hover:text-[#9966CC]">{t('nav.research')}</a>
            <a href={getRelativeLocaleUrl(currentLang, 'reports')} class="text-sm font-medium hover:text-[#9966CC]">{t('nav.reports')}</a>
            <a href={getRelativeLocaleUrl(currentLang, 'about')} class="text-sm font-medium hover:text-[#9966CC]">{t('nav.about')}</a>
            <a href={getRelativeLocaleUrl(currentLang, 'donate')} class="bg-[#9966CC] text-white px-4 py-2 rounded-full text-sm font-medium">{t('nav.donate')}</a>
            <Search />
            <LanguageSwitcher lang={currentLang} />
        </div>
      </div>
    </nav>
    <main class="flex-grow"><slot /></main>
  </body>
</html>
