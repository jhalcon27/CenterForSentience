---
import { getRelativeLocaleUrl } from 'astro:i18n';
const currentPath = Astro.url.pathname;
const locales = ['en', 'de', 'es', 'fr', 'ja', 'zh'];
const currentLocale = Astro.currentLocale || 'en';
// Strip current locale to get the remainder
const remainder = currentPath.replace(new RegExp('^/' + currentLocale), '').replace(/\/$/, '') || '/';
---
<select onchange="window.location.href = this.value">
  {locales.map(l => (
    <option value={getRelativeLocaleUrl(l, remainder.replace(/^\//, ''))} selected={l === currentLocale}>{l}</option>
  ))}
</select>
