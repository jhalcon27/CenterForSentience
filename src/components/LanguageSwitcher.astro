---
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

// Compute path suffix by stripping the current locale prefix from the pathname
let pathSuffix = Astro.url.pathname;
const locales = ['de', 'es', 'fr', 'zh', 'ja'];
for (const loc of locales) {
  if (pathSuffix.startsWith(`/${loc}/`)) { pathSuffix = pathSuffix.slice(loc.length + 1); break; }
  if (pathSuffix === `/${loc}` || pathSuffix === `/${loc}/`) { pathSuffix = '/'; break; }
}
if (!pathSuffix.startsWith('/')) pathSuffix = '/' + pathSuffix;

// Strip leading slash for getRelativeLocaleUrl (it expects a path without leading slash, or '/')
const pathArg = pathSuffix === '/' ? '/' : pathSuffix.replace(/^\//, '');

const labels: Record<string, string> = { en: 'EN', de: 'DE', es: 'ES', fr: 'FR', zh: '中文', ja: '日本語' };
const hrefs: Record<string, string> = {
  en: getRelativeLocaleUrl('en', pathArg),
  de: getRelativeLocaleUrl('de', pathArg),
  es: getRelativeLocaleUrl('es', pathArg),
  fr: getRelativeLocaleUrl('fr', pathArg),
  zh: getRelativeLocaleUrl('zh', pathArg),
  ja: getRelativeLocaleUrl('ja', pathArg),
};
---

<div class="lang-switcher relative group" data-lang-switcher>
  <button
    class="lang-btn flex items-center gap-1.5 text-csr-gray-600 hover:text-csr-primary transition-colors text-sm font-mono px-2 py-1 rounded border border-transparent hover:border-csr-primary/30"
    aria-label="Select language"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span>{labels[lang] ?? 'EN'}</span>
    <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div
    class="lang-dropdown hidden absolute right-0 top-full mt-1 z-50 glass-card rounded-lg border border-csr-gray-200 shadow-lg overflow-hidden min-w-[120px]"
  >
    {(['en', 'de', 'es', 'fr', 'zh', 'ja'] as const).map((loc) => (
      <a
        href={hrefs[loc]}
        class={`flex items-center gap-2 px-3 py-2 text-sm font-mono transition-colors hover:bg-csr-primary/10 hover:text-csr-primary ${lang === loc ? 'text-csr-primary bg-csr-primary/5' : 'text-csr-gray-600'}`}
        aria-current={lang === loc ? 'page' : undefined}
      >
        <span>{labels[loc]}</span>
      </a>
    ))}
  </div>
</div>

<script>
  function initLangSwitchers() {
    const switchers = document.querySelectorAll('[data-lang-switcher]');
    
    switchers.forEach(switcher => {
      const btn = switcher.querySelector('.lang-btn');
      const dropdown = switcher.querySelector('.lang-dropdown');

      if (btn && dropdown) {
        const toggleDropdown = (open: boolean) => {
          if (open) {
            dropdown.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
          } else {
            dropdown.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          }
        };

        const handleClick = (e: Event) => {
          e.stopPropagation();
          const isOpen = !dropdown.classList.contains('hidden');
          document.querySelectorAll('.lang-dropdown').forEach(d => {
             if (d !== dropdown) d.classList.add('hidden');
          });
          toggleDropdown(!isOpen);
        };

        btn.addEventListener('click', handleClick);
      }
    });

    document.addEventListener('click', (e) => {
      const isInsideAny = (e.target as Element).closest('[data-lang-switcher]');
      if (!isInsideAny) {
        document.querySelectorAll('.lang-dropdown').forEach(d => d.classList.add('hidden'));
        document.querySelectorAll('.lang-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));
      }
    });
  }

  initLangSwitchers();
  document.addEventListener('astro:after-swap', initLangSwitchers);
</script>
