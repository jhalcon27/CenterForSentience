---
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

// Routes that exist in every locale
const localizedRoutes = ['', 'research', 'program', 'reports', 'ecosystem', 'about', 'donate', 'contact', 'reports/first-principles', 'reports/bio-electric-fields', 'reports/assembly-theory', 'reports/symmetry-landscapes'];

// Compute path suffix by stripping the current locale prefix and trailing slash
let rawPath = Astro.url.pathname;
const locales = ['de', 'es', 'fr', 'zh', 'ja'];
for (const loc of locales) {
  if (rawPath.startsWith(`/${loc}/`)) { rawPath = rawPath.slice(loc.length + 1); break; }
  if (rawPath === `/${loc}` || rawPath === `/${loc}/`) { rawPath = '/'; break; }
}

// Normalize: strip leading and trailing slashes to get a clean path segment
const cleanPath = rawPath.replace(/^\/+/, '').replace(/\/+$/, '');

// Only preserve the path if it exists in all locales; otherwise fall back to root
const pathArg = localizedRoutes.includes(cleanPath) ? (cleanPath || '/') : '/';

const labels: Record<string, string> = { en: 'EN', de: 'DE', es: 'ES', fr: 'FR', zh: '中文', ja: '日本語' };
const hrefs: Record<string, string> = {
  en: getRelativeLocaleUrl('en', pathArg),
  de: getRelativeLocaleUrl('de', pathArg),
  es: getRelativeLocaleUrl('es', pathArg),
  fr: getRelativeLocaleUrl('fr', pathArg),
  zh: getRelativeLocaleUrl('zh', pathArg),
  ja: getRelativeLocaleUrl('ja', pathArg),
};
---

<details class="lang-switcher relative" data-lang-switcher>
  <summary
    class="lang-btn list-none flex items-center gap-1.5 text-csr-gray-600 hover:text-csr-primary transition-colors text-sm font-mono px-2 py-1 rounded border border-transparent hover:border-csr-primary/30 cursor-pointer select-none"
    aria-label="Select language"
  >
    <span>{labels[lang] ?? 'EN'}</span>
    <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </summary>

  <div
    class="lang-dropdown absolute right-0 top-full mt-1 z-50 glass-card rounded-lg border border-csr-gray-200 shadow-lg overflow-hidden min-w-[120px]"
  >
    {(['en', 'de', 'es', 'fr', 'zh', 'ja'] as const).map((loc) => (
      <a
        href={hrefs[loc]}
        data-lang={loc}
        class={`flex items-center gap-2 px-3 py-2 text-sm font-mono transition-colors hover:bg-csr-primary/10 hover:text-csr-primary ${lang === loc ? 'text-csr-primary bg-csr-primary/5' : 'text-csr-gray-600'}`}
        aria-current={lang === loc ? 'page' : undefined}
      >
        <span>{labels[loc]}</span>
      </a>
    ))}
  </div>
</details>

<script is:inline>
  // This component is rendered twice per page (desktop + mobile nav);
  // guard so document-level listeners are only registered once. Uses event
  // delegation, so it also works if switchers render after this script runs.
  if (!window.__csrLangSwitcherInit) {
    window.__csrLangSwitcherInit = true;

    // Close other open switchers when one opens
    document.addEventListener('toggle', function(e) {
      const switcher = e.target.closest && e.target.closest('[data-lang-switcher]');
      if (!switcher || !switcher.open) return;
      document.querySelectorAll('[data-lang-switcher]').forEach(function(other) {
        if (other !== switcher && other.open) other.removeAttribute('open');
      });
    }, true);

    document.addEventListener('click', function(e) {
      // Store explicit language choice before navigating
      if (e.target.closest && e.target.closest('[data-lang-switcher] [data-lang]')) {
        try { localStorage.setItem('csr-lang-explicit', '1'); } catch(err) {}
        return;
      }
      // Close on outside click
      if (!(e.target.closest && e.target.closest('[data-lang-switcher]'))) {
        document.querySelectorAll('[data-lang-switcher]').forEach(function(s) {
          if (s.open) s.removeAttribute('open');
        });
      }
    });
  }
</script>

<style>
  /* Hide the default marker/triangle on <summary> across browsers */
  details > summary::-webkit-details-marker { display: none; }
  details > summary::marker { display: none; }
</style>
