---
import SectionMark from './SectionMark.astro';
import Glyph from './Glyph.astro';
import SymmetryBackground from './SymmetryBackground.astro';

const papers = [
  {
    num: '01',
    slug: 'first-principles',
    title: 'First Principles of Sentience Research',
    desc: 'A substrate-neutral framework for modeling the physical foundations of awareness. Establishes conceptual definitions for studying representation structure.',
  },
  {
    num: '02',
    slug: 'bio-electric-fields',
    title: 'Bio-Electric Fields as Sentience Substrates',
    desc: 'Bioelectric signaling as a candidate physical basis for awareness, providing biological grounding for topological and dynamical state models.',
  },
  {
    num: '03',
    slug: 'assembly-theory',
    title: 'Assembly Theory as a Metric for Sentience',
    desc: 'Applying assembly index to complexity thresholds in sentient systems. Explores whether assembly theory can serve as a substrate-neutral complexity metric.',
  },
  {
    num: '04',
    slug: 'symmetry-landscapes',
    title: 'Symmetry Landscapes of Valenced Experience',
    desc: 'Geometric invariants and spectral properties as structural signatures of internal representation stability in multi-layer perceptron networks.',
  },
];
---

<!-- ── Header ────────────────────────────────────────────────────────────── -->
<section class="relative pt-20 pb-12 border-b border-csr-gray-200 overflow-hidden">
  <SymmetryBackground variant="spiral" opacity={0.08} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-4">
      <SectionMark />
      <p class="label-mono">Working Papers</p>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">
      Foundational reading
    </h1>
    <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
      Four working papers providing the theoretical scaffolding for CSR's research agenda on representation geometry, biological substrates, and complexity thresholds.
    </p>
  </div>
</section>

<!-- ── Papers Grid ────────────────────────────────────────────────────────── -->
<section class="py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-8">
      <SectionMark />
      <p class="label-mono">Theoretical Scaffolding</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {papers.map((p) => (
        <a
          href={`/reports/${p.slug}/`}
          class="glass-card rounded-2xl p-6 sm:p-8 border border-csr-gray-200 hover:border-csr-primary/30 transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono text-csr-primary font-semibold">
                Working Paper {p.num}
              </span>
              <Glyph />
            </div>
            <h2 class="text-xl font-bold text-csr-black group-hover:text-csr-primary transition-colors mb-3 leading-snug">
              {p.title}
            </h2>
            <p class="text-sm text-csr-gray-600 font-serif leading-relaxed">
              {p.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-csr-gray-100 flex items-center justify-between text-xs font-mono">
            <span class="text-csr-primary group-hover:underline">Read paper →</span>
            <span class="text-csr-gray-400">PDF / HTML</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 glass-card rounded-2xl p-6 border border-csr-gray-200 text-center text-sm font-serif text-csr-gray-600">
      <p>
        Looking for active empirical work? Visit our <a href="/reproductions/" class="text-csr-primary font-sans font-semibold hover:underline">Reproductions</a> section to follow experimental replications.
      </p>
    </div>
  </div>
</section>
