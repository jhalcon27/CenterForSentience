---
import SectionMark from './SectionMark.astro';
import Glyph from './Glyph.astro';
import SymmetryBackground from './SymmetryBackground.astro';
import { getCollection } from 'astro:content';
import { ui, useTranslations } from '../i18n/index';

interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;
const prefix = lang === 'en' ? '' : `/${lang}`;

type Dict = {
  eyebrow: string; h1: string; intro: string;
  flagshipLabel: string; wp05Title: string; inProgress: string; wp05Body: string; seeProgram: string;
  foundationsLabel: string; papers: [string, string][];
};

const L: Record<string, Dict> = {
  en: {
    eyebrow: 'Working Papers', h1: 'Foundational reading',
    intro: "Four working papers providing the theoretical scaffolding for the Digital Valence Program. Plus one in-progress paper that is the program's primary deliverable.",
    flagshipLabel: '2026 Deliverable',
    wp05Title: 'A Digital EEG for AI Sentience: Multi-Scale Structural Biomarkers',
    inProgress: 'In progress',
    wp05Body: 'The flagship deliverable of the 2026 program. A structural, medically inspired "vital signs" monitor for advanced artificial intelligence using non-verbal, substrate-neutral biomarkers. Target: end of 2026.',
    seeProgram: 'See the full program →',
    foundationsLabel: 'Theoretical Foundations',
    papers: [
      ['First Principles of Sentience Research', 'A substrate-neutral framework for modeling the physical foundations of awareness. Establishes the conceptual vocabulary for the Digital Valence Program.'],
      ['Bio-Electric Fields as Sentience Substrates', 'Bioelectric signaling as a candidate physical basis for awareness. Provides biological calibration data for the digital valence framework.'],
      ['Assembly Theory as a Metric for Sentience', 'Applying assembly index to complexity thresholds in sentient systems. Explores whether assembly theory can serve as a substrate-neutral complexity metric.'],
      ['Symmetry Landscapes of Valenced Experience', 'Geometric invariants as structural signatures of positive valence. The most direct theoretical precursor to the 2026 program.'],
    ],
  },
};
const t = L[lang] ?? L.en;
const slugs = ['first-principles', 'bio-electric-fields', 'assembly-theory', 'symmetry-landscapes'];

// Research notes. Drafts are listed only under `astro dev`.
const tn = useTranslations('en');
const notes = (await getCollection('notes', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const tagLabel = (tag: string) => {
  const key = `notes.tag.${tag.toLowerCase()}`;
  return key in ui.en ? tn(key as keyof typeof ui.en) : tag;
};
---

<!-- ── Header ────────────────────────────────────────────────────────────── -->
<section class="relative pt-20 pb-12 border-b border-csr-gray-200 overflow-hidden">
  <SymmetryBackground variant="spiral" opacity={0.08} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="label-mono mb-4">{t.eyebrow}</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">{t.h1}</h1>
    <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">{t.intro}{notes.length > 0 && ` ${tn('notes.intro')}`}</p>
  </div>
</section>

<!-- ── In-Progress Flagship ──────────────────────────────────────────────── -->
<section class="pt-8 pb-14">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-6"><SectionMark /><p class="label-mono">{t.flagshipLabel}</p></div>
    <div class="bg-white border border-csr-primary/25 rounded-2xl p-6 md:p-8 shadow-card">
      <div class="flex flex-col sm:flex-row sm:items-start gap-4">
        <div class="shrink-0 flex flex-col items-start gap-2">
          <span class="label-mono text-[10px]">Working Paper 05</span>
          <Glyph name="qualia" size={64} />
        </div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <h2 class="text-xl font-bold text-csr-black leading-snug">{t.wp05Title}</h2>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-csr-primary/10 text-csr-primary text-[10px] font-mono uppercase tracking-wider shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-csr-primary animate-pulse inline-block"></span>
              {t.inProgress}
            </span>
          </div>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4 font-serif">{t.wp05Body}</p>
          <a href={`${prefix}/program/`} class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">{t.seeProgram}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── Published Working Papers ──────────────────────────────────────────── -->
<section class="py-14 border-t border-csr-gray-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-6"><SectionMark /><p class="label-mono">{t.foundationsLabel}</p></div>
    <div class="space-y-4">
      {t.papers.map(([title, desc], i) => (
        <a href={`${prefix}/reports/${slugs[i]}/`} class="group flex flex-col sm:flex-row gap-4 p-6 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <div class="shrink-0"><span class="label-mono text-[10px]">Working Paper 0{i + 1}</span></div>
          <div class="flex-1">
            <h3 class="font-bold text-csr-black text-base group-hover:text-csr-primary transition-colors mb-2 leading-snug">{title}</h3>
            <p class="text-sm text-csr-gray-600 leading-relaxed">{desc}</p>
          </div>
          <div class="shrink-0 self-center">
            <svg class="w-4 h-4 text-csr-gray-300 group-hover:text-csr-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

{notes.length > 0 && (
  <section class="py-14 border-t border-csr-gray-200">
    <!-- ── Research Notes (only rendered when at least one note is published) ── -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6"><SectionMark /><p class="label-mono">{tn('notes.heading')}</p></div>
      <ul class="divide-y divide-csr-gray-200 border-y border-csr-gray-200">
        {notes.map((note) => (
          <li>
            <a href={`/reports/notes/${note.slug}/`} class="group block py-5">
              <div class="flex items-center gap-3 mb-1.5 flex-wrap">
                <span class="text-xs font-mono text-csr-gray-400">{note.data.date.toISOString().slice(0, 10)}</span>
                {note.data.tag && (
                  <span class="px-2 py-0.5 rounded-full border border-csr-gray-200 text-csr-gray-500 text-[10px] font-mono uppercase tracking-wider">{tagLabel(note.data.tag)}</span>
                )}
                {note.data.status === 'in-progress' && (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-csr-primary/10 text-csr-primary text-[10px] font-mono uppercase tracking-wider shrink-0">
                    <span class="w-1.5 h-1.5 rounded-full bg-csr-primary animate-pulse inline-block"></span>
                    {tn('notes.inProgress')}
                  </span>
                )}
              </div>
              <h3 class="font-bold text-csr-black text-base group-hover:text-csr-primary transition-colors mb-1 leading-snug">{note.data.title}</h3>
              <p class="text-sm text-csr-gray-600 leading-relaxed">{note.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
