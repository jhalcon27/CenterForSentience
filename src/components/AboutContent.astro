---
import SectionMark from './SectionMark.astro';
import Glyph from './Glyph.astro';
import SymmetryBackground from './SymmetryBackground.astro';

const relatedWork = [
  {
    name: "Qualia Research Institute (QRI)",
    description: "An independent research group exploring the mathematical structure of conscious experience. Known for proposing the Symmetry Theory of Valence (STV) as a candidate model for phenomenal well-being.",
    link: "https://qri.org",
    tag: "Related work"
  },
  {
    name: "Reciprocal Research",
    description: "Empirical interpretability-based welfare research focused on detecting and steering distress circuits in frontier LLMs. Complements open-source evaluations of internal model representations.",
    link: "https://reciprocalresearch.org",
    tag: "Related work"
  },
  {
    name: "Eleos AI",
    description: "Empirical AI welfare research applying mechanistic interpretability to probe internal states in frontier models.",
    link: "https://eleos.ai",
    tag: "Related work"
  },
  {
    name: "NYU Center for Mind, Ethics, and Policy",
    description: "Conceptual and policy work on the moral status of AI systems, providing philosophical and governance scaffolding for machine consciousness discussions.",
    link: "https://wp.nyu.edu/consciousness",
    tag: "Related work"
  },
  {
    name: "Anthropic Model Welfare",
    description: "Frontier-lab research team investigating the potential for morally relevant internal states and behavioral attractors in large language models.",
    link: "https://www.anthropic.com",
    tag: "Related work"
  },
  {
    name: "Levin Lab",
    description: "Led by Michael Levin at Tufts University, researching bioelectricity, regenerative biology, and synthetic morphology.",
    link: "https://www.drmichaellevin.org",
    tag: "Related work"
  },
  {
    name: "Cronin Group",
    description: "Led by Lee Cronin at the University of Glasgow, researching Assembly Theory and complexity thresholds across physical systems.",
    link: "https://www.chem.gla.ac.uk/cronin/",
    tag: "Related work"
  },
  {
    name: "Robin Carhart-Harris",
    description: "Director of the Neuroscape Psychedelics Division at UCSF, researching neural entropy and the physical dynamics of conscious and valenced states.",
    link: "https://profiles.ucsf.edu/robin.carhart-harris",
    tag: "Related work"
  },
  {
    name: "Sentience Institute",
    description: "An interdisciplinary think tank researching long-term social and moral circle expansion regarding present and future sentient beings.",
    link: "https://www.sentienceinstitute.org",
    tag: "Related work"
  }
];
---

<!-- ── Header ─────────────────────────────────────────────────────────────── -->
<section class="relative pt-20 pb-16 border-b border-csr-gray-200 overflow-hidden">
  <SymmetryBackground variant="lattice" opacity={0.08} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-4">
      <SectionMark />
      <p class="label-mono">About CSR</p>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-3xl leading-tight">
      Independent, self-directed sentience research.
    </h1>
    <p class="text-xl text-csr-gray-700 leading-relaxed max-w-2xl font-serif">
      The Center for Sentience Research (CSR) is an independent, unfunded research project run by Jhonatan Serna in Zurich.
    </p>
  </div>
</section>

<!-- ── Mission & Structure ────────────────────────────────────────────────── -->
<section class="py-16 border-b border-csr-gray-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-csr-black mb-4">
        Project and Cadence
      </h2>
      <div class="prose prose-slate max-w-none font-serif text-lg leading-relaxed text-csr-gray-700 space-y-4">
        <p>
          CSR is run by one person, Jhonatan Serna, working in Zurich on a dedicated weekly cadence of one day a week. The project is completely unfunded and self-directed. The work proceeds deliberately: researching, reproducing, and writing up mechanistic interpretability results one paper at a time.
        </p>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-bold tracking-tight text-csr-black mb-4">
        Why This Work Matters
      </h2>
      <div class="prose prose-slate max-w-none font-serif text-lg leading-relaxed text-csr-gray-700 space-y-4">
        <p>
          We take seriously the possibility that scaled computational architectures could one day support states with positive or negative character. If and when artificial neural networks exhibit internal states relevant to welfare or suffering, we must be able to recognize them through rigorous, objective mathematical footprints in internal model representations, rather than relying on easily gamified verbal self-reports. Longitudinal surveys indicate that public perspective on artificial sentience is shifting,<sup><a href="#ref-1" class="text-csr-primary hover:underline">[1]</a></sup> while scientific frameworks for evaluating machine consciousness continue to mature.<sup><a href="#ref-2" class="text-csr-primary hover:underline">[2]</a></sup>
        </p>
        <p>
          We do not claim that current large language models are conscious or capable of feeling. They may well be functional mimics with no inner life. But verifying how model representations are structured is an empirical prerequisite to understanding what these systems compute. We start from the ground up: reproducing foundational mechanistic interpretability results in transformer architectures, verifying circuit behaviors, and examining representation geometry across model layers.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ── Related Work (Ecosystem) ───────────────────────────────────────────── -->
<section id="related-work" class="py-16 border-b border-csr-gray-200 bg-white/40">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-3">
      <SectionMark />
      <p class="label-mono">Research Network</p>
    </div>
    <h2 class="text-3xl font-bold tracking-tight text-csr-black mb-4">
      Related work
    </h2>
    <p class="text-csr-gray-600 font-serif text-base mb-8 max-w-2xl">
      Laboratories, research groups, and think tanks whose work informs, parallels, or complements our research on representation geometry and machine sentience.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {relatedWork.map((org) => (
        <a
          href={org.link}
          target="_blank"
          rel="noopener noreferrer"
          class="glass-card rounded-2xl p-6 border border-csr-gray-200 hover:border-csr-primary/30 transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-csr-gray-400 uppercase tracking-wider">
                {org.tag}
              </span>
              <span class="text-xs font-mono text-csr-primary group-hover:translate-x-0.5 transition-transform">
                ↗
              </span>
            </div>
            <h3 class="text-lg font-bold text-csr-black group-hover:text-csr-primary transition-colors mb-2">
              {org.name}
            </h3>
            <p class="text-sm text-csr-gray-600 font-serif leading-relaxed">
              {org.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ── References ──────────────────────────────────────────────────────────── -->
<section class="py-12 border-b border-csr-gray-200 bg-csr-cream">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="label-mono text-xs mb-4">References</p>
    <div class="space-y-3 text-xs text-csr-gray-500 font-mono leading-relaxed">
      <p id="ref-1">
        [1] Anthis, J. R. et al. (2025). <em>Perceptions of Sentient AI and Other Digital Minds: Evidence from the AI, Morality, and Sentience (AIMS) Survey.</em> CHI 2025. <a href="https://dl.acm.org/doi/10.1145/3706598.3713329" target="_blank" rel="noopener noreferrer" class="text-csr-primary hover:underline break-all">https://dl.acm.org/doi/10.1145/3706598.3713329</a>
      </p>
      <p id="ref-2">
        [2] Butlin, P. et al. (2023). <em>Consciousness in Artificial Intelligence: Insights from the Science of Consciousness.</em> arXiv. <a href="https://arxiv.org/abs/2308.08708" target="_blank" rel="noopener noreferrer" class="text-csr-primary hover:underline break-all">https://arxiv.org/abs/2308.08708</a>
      </p>
    </div>
  </div>
</section>
