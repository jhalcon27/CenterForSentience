  'Butlin, P. et al. (2023). <em>Consciousness in Artificial Intelligence: Insights from the Science of Consciousness.</em> arXiv. <a href="https://arxiv.org/abs/2308.08708" target="_blank" rel="noopener noreferrer" class="text-csr-primary hover:underline break-all">https://arxiv.org/abs/2308.08708</a>',
  'Shulman, C. &amp; Bostrom, N. (2025). <em>Conscious Artificial Intelligence and Biological Naturalism.</em> Neuroscience of Consciousness. <a href="https://pubmed.ncbi.nlm.nih.gov/40257177/" target="_blank" rel="noopener noreferrer" class="text-csr-primary hover:underline break-all">https://pubmed.ncbi.nlm.nih.gov/40257177/</a>',
];
const glyphNames = ['qualia', 'digital', 'measurement'] as const;
---

<!-- ── Header ────────────────────────────────────────────────────────────── -->
<section class="relative pt-20 pb-12 border-b border-csr-gray-200 overflow-hidden">
  <SymmetryBackground variant="rings" opacity={0.09} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="label-mono mb-4">{t.eyebrow}</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">{t.h1}</h1>
    <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">{t.intro}</p>
  </div>
</section>

<!-- ── Mission & Philosophy ───────────────────────────────────────────────── -->
<section class="py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">

    <!-- Mission -->
    <div>
      <div class="flex items-center gap-3 mb-5"><SectionMark /><h2 class="text-xl font-bold text-csr-black">{t.missionH}</h2></div>
      <div class="text-csr-gray-600 leading-relaxed text-lg font-serif max-w-2xl space-y-4">
        {t.missionP.map((p) => <p set:html={p}></p>)}
      </div>
    </div>

    <!-- Ethics & Philosophy -->
    <div>
      <div class="flex items-center gap-3 mb-5"><SectionMark /><h2 class="text-xl font-bold text-csr-black">{t.ethicsH}</h2></div>
      <div class="text-csr-gray-600 leading-relaxed text-lg font-serif max-w-2xl space-y-4">
        {t.ethicsP.map((p) => <p set:html={p}></p>)}
      </div>
    </div>

    <!-- Approach cards -->
    <div>
      <div class="flex items-center gap-3 mb-6"><SectionMark /><h2 class="text-xl font-bold text-csr-black">{t.approachH}</h2></div>
      <div class="mb-6 max-w-3xl">
        <ValenceCurve lang={lang} caption={t.curveCaption} />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {t.cards.map(([title, desc], i) => (
          <div class="p-6 bg-white border border-csr-gray-100 rounded-2xl shadow-card">
            <div class="mb-5 flex justify-center"><Glyph name={glyphNames[i]} size={56} /></div>
            <h3 class="font-bold text-csr-black mb-2 text-sm">{title}</h3>
            <p class="text-xs text-csr-gray-650 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Team -->
    <div>
      <div class="flex items-center gap-3 mb-6"><SectionMark /><h2 class="text-xl font-bold text-csr-black">{t.teamH}</h2></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {team.map((m) => (
          <div class={`p-7 bg-white rounded-2xl shadow-card flex flex-col items-center text-center ${m.recruiting ? 'border-2 border-dashed border-csr-primary/40' : 'border border-csr-gray-100'}`}>
            <div class={`w-28 h-28 rounded-full mb-5 overflow-hidden ring-2 ring-offset-2 ring-offset-white shrink-0 ${m.recruiting ? 'ring-csr-primary/30 bg-csr-gray-50 flex items-center justify-center' : 'ring-csr-primary/15 bg-csr-gray-100 shadow-soft'}`}>
              {m.recruiting ? (
                <span class="text-4xl font-light text-csr-primary/60 leading-none">+</span>
              ) : (
                <img src={`/images/${m.img}`} alt={m.name} class="w-full h-full object-cover object-center" />
              )}
            </div>
            <h3 class="font-bold text-lg text-csr-black mb-1">{m.name}</h3>
            {m.recruiting ? (
              <span class="inline-block label-mono text-[9px] mb-3 px-2 py-0.5 rounded-full bg-csr-primary/10 text-csr-primary">{m.role}</span>
            ) : (
              <p class="label-mono text-[10px] mb-3">{m.role}</p>
            )}
            <p class={`text-sm text-csr-gray-500 leading-relaxed ${m.italic ? 'italic' : ''}`} set:html={m.bio}></p>
          </div>
        ))}
      </div>
    </div>

    <!-- Ecosystem Positioning -->
    <div>
      <div class="flex items-center gap-3 mb-5"><SectionMark /><h2 class="text-xl font-bold text-csr-black">{t.ecoH}</h2></div>
      <div class="text-csr-gray-600 leading-relaxed text-lg font-serif max-w-2xl space-y-4">
        {t.ecoP.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <!-- Founding -->
    <div>
      <div class="flex items-center gap-3 mb-5"><SectionMark /><h2 class="text-xl font-bold text-csr-black">{t.foundH}</h2></div>
      <p class="text-csr-gray-600 leading-relaxed text-lg font-serif max-w-2xl">{t.foundP}</p>
    </div>

  </div>
</section>

<!-- ── References ───────────────────────────────────────────────────────── -->
<section class="py-16 border-t border-csr-gray-200 bg-csr-gray-50/30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-6"><SectionMark /><p class="label-mono">{t.refsH}</p></div>
    <ol class="space-y-4 max-w-3xl">
      {refs.map((r, i) => (
        <li id={`ref-a${i + 1}`} class="flex gap-3 text-xs text-csr-gray-600 leading-relaxed">
          <span class="shrink-0 font-mono text-csr-primary">[{i + 1}]</span>
          <span set:html={r}></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ── Contact CTA ───────────────────────────────────────────────────────── -->
<section class="py-16 border-t border-csr-gray-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white border border-csr-gray-100 rounded-3xl shadow-card p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <p class="label-mono mb-3">{t.ctaLabel}</p>
        <h2 class="text-2xl font-bold text-csr-black mb-3">{t.ctaH}</h2>
        <p class="text-csr-gray-600 text-sm leading-relaxed max-w-md">{t.ctaBody}</p>
      </div>
      <div class="shrink-0 flex flex-col gap-3">
        <a href={`${prefix}/contact/`} class="btn-primary whitespace-nowrap">{t.ctaBtn1}</a>
        <a href={`${prefix}/donate/`} class="btn-secondary whitespace-nowrap text-center">{t.ctaBtn2}</a>
      </div>
    </div>
  </div>
</section>
