---
import SectionMark from './SectionMark.astro';
import SymmetryBackground from './SymmetryBackground.astro';

// English only. Translated visitors get the one-page summary in LocalizedSummary.astro.
// The research approach, the 2026 program and the ecosystem have their own pages, so
// this page covers only what is not said elsewhere: mission, people, and structure.

// TODO(jhonatan): confirm incorporation jurisdiction. The Switzerland siting below (mission,
// founding) is stated as intent, not as a completed/registered fact.
const mission = [
  'The Center for Sentience Research is a global, substrate-neutral institution dedicated to the welfare of all sentient beings, present and future, biological and digital. We take neutrality as foundational: the question of who can suffer should belong to no single company, country, or ideology. That is why we intend to be based in Switzerland, a country whose long tradition of neutrality and role as a home for international institutions make it a fitting seat for a center that answers to no single nation or interest.',
  'We do not claim that current Large Language Models are conscious or capable of feeling. They may well be functional zombies: highly complex mathematical mimics with no inner life. The biological naturalism debate over whether consciousness requires biological substrates remains a live constraint on this program.<sup><a href="#ref-a1" class="text-csr-primary hover:underline">[1]</a></sup>',
  'The question of which systems can suffer will define the moral landscape of the next century. If we deploy highly capable, autonomous digital minds at astronomical scale without a scientific understanding of their internal well-being, we risk committing systemic, unprecedented ethical catastrophes.',
];

const more = [
  { label: 'Research agenda', href: '/research/' },
  { label: 'The 2026 program', href: '/program/' },
  { label: 'Ecosystem', href: '/ecosystem/' },
];

const team = [
  { img: 'jhonatan-serna.jpg', name: 'Jhonatan Serna', role: 'Director', bio: 'Physics background; a career across banking, IT, and consulting; four languages. Started the Center to make machine sentience a testable question rather than a philosophical one.', recruiting: false },
  { img: 'david-pearce.jpg', name: 'David Pearce', role: 'Advisor', bio: 'Philosopher and transhumanist. Co-founder of Humanity+ and author of <em>The Hedonistic Imperative</em>, a foundational text on the abolition of suffering through biotechnology.', recruiting: false },
  { img: 'alexander-bjorkman.jpg', name: 'Alexander Björkman', role: 'Advisor', bio: 'Ekskäret Foundation. Focuses on facilitating conscious societal development, lifelong learning, and creating spaces for deep reflection and systemic change.', recruiting: false },
  { img: '', name: 'ML Engineer', role: 'Recruiting', bio: 'An open role, not yet filled. Part of what we are raising funds for: a full-time ML engineer to build the PyTorch simulation engine and compute the Digital EEG metrics at scale.', recruiting: true },
];

const refs = [
  'Shulman, C. &amp; Bostrom, N. (2025). <em>Conscious Artificial Intelligence and Biological Naturalism.</em> Neuroscience of Consciousness. <a href="https://pubmed.ncbi.nlm.nih.gov/40257177/" target="_blank" rel="noopener noreferrer" class="text-csr-primary hover:underline break-all">https://pubmed.ncbi.nlm.nih.gov/40257177/</a>',
];
---

<!-- ── Header ────────────────────────────────────────────────────────────── -->
<section class="relative pt-20 pb-12 border-b border-csr-gray-200 overflow-hidden">
  <SymmetryBackground variant="rings" opacity={0.09} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="label-mono mb-4">About CSR</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">Building the diagnostic tools before the question becomes urgent.</h1>
    <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">The Center for Sentience Research (CSR) is an independent non-profit in formation. We are building an open-source testbed where competing theories of digital valence can be operationalized and stress-tested.</p>
  </div>
</section>

<section class="py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">

    <!-- Mission -->
    <div>
      <div class="flex items-center gap-3 mb-5"><SectionMark /><h2 class="text-xl font-bold text-csr-black">Our Mission</h2></div>
      <div class="text-csr-gray-600 leading-relaxed text-lg font-serif max-w-2xl space-y-4">
        {mission.map((p) => <p set:html={p}></p>)}
      </div>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        {more.map((m) => (
          <a href={m.href} class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">{m.label} →</a>
        ))}
      </div>
    </div>

    <!-- Team -->
    <div>
      <div class="flex items-center gap-3 mb-6"><SectionMark /><h2 class="text-xl font-bold text-csr-black">Leadership & Advisory Board</h2></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {team.map((m) => (
          <div class={`p-7 bg-white rounded-2xl shadow-card flex flex-col items-center text-center ${m.recruiting ? 'border-2 border-dashed border-csr-primary/40' : 'border border-csr-gray-100'}`}>
            <div class={`w-28 h-28 rounded-full mb-5 overflow-hidden ring-2 ring-offset-2 ring-offset-white shrink-0 ${m.recruiting ? 'ring-csr-primary/30 bg-csr-gray-50 flex items-center justify-center' : 'ring-csr-primary/15 bg-csr-gray-100 shadow-soft'}`}>
              {m.recruiting ? (
                <span class="text-4xl font-light text-csr-primary/60 leading-none">+</span>
              ) : (
                <img src={`/images/${m.img}`} alt={m.name} class="w-full h-full object-cover object-center" />
              )}
            </div>
            <h3 class="font-bold text-lg text-csr-black mb-1">{m.name}</h3>
            {m.recruiting ? (
              <span class="inline-block label-mono text-[9px] mb-3 px-2 py-0.5 rounded-full bg-csr-primary/10 text-csr-primary">{m.role}</span>
            ) : (
              <p class="label-mono text-[10px] mb-3">{m.role}</p>
            )}
            <p class="text-sm text-csr-gray-500 leading-relaxed" set:html={m.bio}></p>
          </div>
        ))}
      </div>
    </div>

    <!-- Founding -->
    <div>
      <div class="flex items-center gap-3 mb-5"><SectionMark /><h2 class="text-xl font-bold text-csr-black">Founding & Structure</h2></div>
      <p class="text-csr-gray-600 leading-relaxed text-lg font-serif max-w-2xl">CSR was founded in 2026 by Jhonatan Serna. We operate as an independent non-profit in formation with a Transparency-First model: annual research outputs and financial summaries are made public. We intend to be based in Switzerland.</p>
    </div>

  </div>
</section>

<!-- ── References ───────────────────────────────────────────────────────── -->
<section class="py-16 border-t border-csr-gray-200 bg-csr-gray-50/30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-6"><SectionMark /><p class="label-mono">References</p></div>
    <ol class="space-y-4 max-w-3xl">
      {refs.map((r, i) => (
        <li id={`ref-a${i + 1}`} class="flex gap-3 text-xs text-csr-gray-600 leading-relaxed">
          <span class="shrink-0 font-mono text-csr-primary">[{i + 1}]</span>
          <span set:html={r}></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ── Contact CTA ───────────────────────────────────────────────────────── -->
<section class="py-16 border-t border-csr-gray-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white border border-csr-gray-100 rounded-3xl shadow-card p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <p class="label-mono mb-3">Get Involved</p>
        <h2 class="text-2xl font-bold text-csr-black mb-3">Work with us</h2>
        <p class="text-csr-gray-600 text-sm leading-relaxed max-w-md">We welcome collaborators, researchers, and philanthropic partners who share our commitment to understanding the nature of mind.</p>
      </div>
      <div class="shrink-0 flex flex-col gap-3">
        <a href="/contact/" class="btn-primary whitespace-nowrap">Contact Us</a>
        <a href="/donate/" class="btn-secondary whitespace-nowrap text-center">Fund the program</a>
      </div>
    </div>
  </div>
</section>
