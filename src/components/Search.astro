---
---
<div class="search-container relative ml-4" data-csr-search>
  <button
    class="search-btn p-2 text-csr-gray-600 hover:text-csr-primary transition-colors rounded-full hover:bg-csr-gray-50"
    aria-label="Search site"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </button>

  <div class="search-overlay hidden fixed inset-0 z-[60] bg-[#FFF8F0]/95 backdrop-blur-sm p-4 md:p-20">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-8 border-b-2 border-csr-primary pb-4">
        <input
          type="text"
          placeholder="Search research, reports, and focus areas..."
          class="search-input w-full bg-transparent border-none text-2xl md:text-4xl font-bold focus:ring-0 placeholder:text-csr-gray-200 text-csr-black"
        />
        <button class="close-search p-2 text-csr-gray-600 hover:text-csr-black">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="search-results space-y-6">
        <!-- Results appear here -->
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function initSearch() {
    const containers = document.querySelectorAll('[data-csr-search]');
    
    containers.forEach(function(container) {
      const btn = container.querySelector('.search-btn');
      const overlay = container.querySelector('.search-overlay');
      const closeBtn = container.querySelector('.close-search');
      const input = container.querySelector('.search-input');

      if (btn) btn.addEventListener('click', function() {
        if (overlay) overlay.classList.remove('hidden');
        if (input) input.focus();
        document.body.style.overflow = 'hidden';
      });

      const close = function() {
        if (overlay) overlay.classList.add('hidden');
        document.body.style.overflow = '';
      };

      if (closeBtn) closeBtn.addEventListener('click', close);
      if (overlay) overlay.addEventListener('click', function(e) {
        if (e.target === overlay) close();
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') close();
      });

      // Search index covering all site pages
      const pages = [
        { title: 'First Principles of Sentience Research', type: 'White Paper', url: '/reports/first-principles' },
        { title: 'Bio-Electric Fields as Sentience Substrates', type: 'White Paper', url: '/reports/bio-electric-fields' },
        { title: 'Assembly Theory as a Metric for Sentience', type: 'White Paper', url: '/reports/assembly-theory' },
        { title: 'Symmetry Landscapes of Valenced Experience', type: 'White Paper', url: '/reports/symmetry-landscapes' },
        { title: 'Research Reports', type: 'Page', url: '/reports/' },
        { title: 'Research Agenda', type: 'Page', url: '/research' },
        { title: 'Biological Intelligence', type: 'Research Track', url: '/research#biological' },
        { title: 'Digital Minds & AI Safety', type: 'Research Track', url: '/research#digital' },
        { title: 'Physics of Qualia', type: 'Research Track', url: '/research#qualia' },
        { title: 'About the Center for Sentience Research', type: 'Page', url: '/about' },
        { title: 'Support / Donate', type: 'Page', url: '/donate' },
        { title: 'Tax-Deductible Contributions', type: 'Policy', url: '/donate' },
        { title: 'Contact', type: 'Page', url: '/contact' },
        { title: 'Substrate Neutrality', type: 'Concept', url: '/research#biological' },
        { title: 'Neural Entropy', type: 'Concept', url: '/reports/first-principles' },
        { title: 'Active Inference', type: 'Concept', url: '/reports/first-principles' },
        { title: 'Phenomenology Engineering', type: 'Concept', url: '/reports/first-principles' },
      ];

      if (input) input.addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase().trim();
        const resultsContainer = container.querySelector('.search-results');
        if (!resultsContainer) return;

        if (query.length < 2) {
          resultsContainer.innerHTML = '';
          return;
        }

        const matches = pages.filter(function(p) {
          return p.title.toLowerCase().includes(query) || p.type.toLowerCase().includes(query);
        });
        
        resultsContainer.innerHTML = matches.length > 0 
          ? matches.map(function(m) { return `
              <a href="${m.url}" class="block p-4 rounded-xl hover:bg-csr-gray-100 border border-transparent hover:border-csr-gray-200 transition-all">
                <p class="text-xs font-mono uppercase tracking-widest text-csr-primary mb-1">${m.type}</p>
                <h4 class="text-xl font-bold text-csr-black">${m.title}</h4>
              </a>
            `; }).join('')
          : `<p class="text-csr-gray-600 italic">No results found for "<strong>${query}</strong>"</p>`;
      });
    });
  }

  initSearch();
  document.addEventListener('astro:after-swap', initSearch);
</script>
