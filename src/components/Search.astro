---
interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

const prefix = lang === 'en' ? '' : `/${lang}`;

const ui: Record<string, { placeholder: string; noResults: string }> = {
  en: { placeholder: 'Search research, reports, and focus areas...', noResults: 'No results found for' },
  de: { placeholder: 'Forschung, Berichte und Schwerpunkte durchsuchen...', noResults: 'Keine Ergebnisse für' },
  es: { placeholder: 'Buscar investigación, informes y áreas de enfoque...', noResults: 'No se encontraron resultados para' },
  fr: { placeholder: 'Rechercher recherches, rapports et axes de travail...', noResults: 'Aucun résultat pour' },
  zh: { placeholder: '搜索研究、报告和重点领域...', noResults: '未找到相关结果：' },
  ja: { placeholder: '研究、レポート、重点分野を検索...', noResults: '該当する結果が見つかりません：' },
};
const t = ui[lang] ?? ui.en;
---
<div class="search-container relative ml-4" data-csr-search>
  <button
    class="search-btn p-2 text-csr-gray-600 hover:text-csr-primary transition-colors rounded-full hover:bg-csr-gray-50"
    aria-label="Search site"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </button>

  <div class="search-overlay hidden fixed inset-0 z-[60] bg-[#FFF8F0]/95 backdrop-blur-sm p-4 md:p-20">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-8 border-b-2 border-csr-primary pb-4">
        <input
          type="text"
          placeholder={t.placeholder}
          class="search-input w-full bg-transparent border-none text-2xl md:text-4xl font-bold focus:ring-0 placeholder:text-csr-gray-200 text-csr-black"
        />
        <button class="close-search p-2 text-csr-gray-600 hover:text-csr-black" aria-label="Close search">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="search-results space-y-6">
        <!-- Results appear here -->
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ prefix, noResultsText: t.noResults }}>
  // This component is rendered twice per page (desktop + mobile nav);
  // guard so setup only runs once, and wait for DOMContentLoaded so both
  // containers exist before wiring them up.
  if (!window.__csrSearchInit) {
    window.__csrSearchInit = true;

    // Search index covering all site pages (paths are locale-prefixed at runtime)
    const pages = [
      { title: 'First Principles of Sentience Research', type: 'White Paper', path: '/reports/first-principles/' },
      { title: 'Bio-Electric Fields as Sentience Substrates', type: 'White Paper', path: '/reports/bio-electric-fields/' },
      { title: 'Assembly Theory as a Metric for Sentience', type: 'White Paper', path: '/reports/assembly-theory/' },
      { title: 'Symmetry Landscapes of Valenced Experience', type: 'White Paper', path: '/reports/symmetry-landscapes/' },
      { title: 'Research Reports', type: 'Page', path: '/reports/' },
      { title: 'The Digital Valence Program', type: 'Research Agenda', path: '/research/' },
      { title: 'Mission & Theory of Change', type: 'Research Agenda', path: '/research/#mission' },
      { title: 'Measurement', type: 'Research Agenda', path: '/research/#measurement' },
      { title: 'Mechanisms', type: 'Research Agenda', path: '/research/#mechanisms' },
      { title: 'Intervention', type: 'Research Agenda', path: '/research/#intervention' },
      { title: 'Substrate Neutrality', type: 'Research Agenda', path: '/research/#substrate' },
      { title: 'About the Center for Sentience Research', type: 'Page', path: '/about/' },
      { title: 'Support / Donate', type: 'Page', path: '/donate/' },
      { title: 'Donations & Fiscal Sponsorship', type: 'Policy', path: '/donate/' },
      { title: 'Contact', type: 'Page', path: '/contact/' },
      { title: 'Neural Entropy', type: 'Concept', path: '/reports/first-principles/' },
      { title: 'Active Inference', type: 'Concept', path: '/reports/first-principles/' },
      { title: 'Phenomenology Engineering', type: 'Concept', path: '/reports/first-principles/' },
    ];

    const init = function() {
      const containers = document.querySelectorAll('[data-csr-search]');

      const closeAll = function() {
        containers.forEach(function(container) {
          const overlay = container.querySelector('.search-overlay');
          if (overlay) overlay.classList.add('hidden');
        });
        document.body.style.overflow = '';
      };

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeAll();
      });

      containers.forEach(function(container) {
        const btn = container.querySelector('.search-btn');
        const overlay = container.querySelector('.search-overlay');
        const closeBtn = container.querySelector('.close-search');
        const input = container.querySelector('.search-input');

        if (btn) btn.addEventListener('click', function() {
          if (overlay) overlay.classList.remove('hidden');
          if (input) input.focus();
          document.body.style.overflow = 'hidden';
        });

        if (closeBtn) closeBtn.addEventListener('click', closeAll);
        if (overlay) overlay.addEventListener('click', function(e) {
          if (e.target === overlay) closeAll();
        });

        if (input) input.addEventListener('input', function(e) {
          const query = e.target.value.toLowerCase().trim();
          const resultsContainer = container.querySelector('.search-results');
          if (!resultsContainer) return;

          resultsContainer.textContent = '';
          if (query.length < 2) return;

          const matches = pages.filter(function(p) {
            return p.title.toLowerCase().includes(query) || p.type.toLowerCase().includes(query);
          });

          if (matches.length > 0) {
            matches.forEach(function(m) {
              const link = document.createElement('a');
              link.href = prefix + m.path;
              link.className = 'block p-4 rounded-xl hover:bg-csr-gray-100 border border-transparent hover:border-csr-gray-200 transition-all';

              const type = document.createElement('p');
              type.className = 'text-xs font-mono uppercase tracking-widest text-csr-primary mb-1';
              type.textContent = m.type;

              const title = document.createElement('h4');
              title.className = 'text-xl font-bold text-csr-black';
              title.textContent = m.title;

              link.appendChild(type);
              link.appendChild(title);
              resultsContainer.appendChild(link);
            });
          } else {
            const empty = document.createElement('p');
            empty.className = 'text-csr-gray-600 italic';
            empty.textContent = noResultsText + ' "' + e.target.value.trim() + '"';
            resultsContainer.appendChild(empty);
          }
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  }
</script>
