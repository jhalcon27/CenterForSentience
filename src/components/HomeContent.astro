const t = L[lang] ?? L.en;
const slugs = ['first-principles', 'bio-electric-fields', 'assembly-theory', 'symmetry-landscapes'];
---

<!-- ── Hero ──────────────────────────────────────────────────────────────── -->
<section class="relative pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
  <SymmetryBackground variant="lissajous" opacity={0.10} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="label-mono mb-5">{t.eyebrow}</p>
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-csr-black mb-5 leading-[1.08] max-w-3xl">{t.h1}</h1>
    <div class="max-w-2xl">
      <p class="text-xl font-medium text-csr-gray-700 mb-5 leading-snug">{t.sub}</p>
      <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif mb-6" set:html={t.heroP1}></p>
      <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif mb-6" set:html={t.heroMid}></p>
      <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif" set:html={t.heroP2}></p>
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href={`${prefix}/program/`} class="btn-primary">{t.ctaSee}</a>
      <a href={`${prefix}/research/`} class="btn-secondary">{t.ctaAgenda}</a>
    </div>
  </div>
</section>

<!-- ── The 2026 Goal ─────────────────────────────────────────────────────── -->
<section class="py-16 border-t border-csr-gray-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <ProgramStatus lang={lang} />
  </div>
</section>

<!-- ── Focus Areas ───────────────────────────────────────────────────────── -->
<section class="py-16 border-t border-csr-gray-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-3"><SectionMark /><p class="label-mono">{t.pillarsLabel}</p></div>
    <p class="text-csr-gray-500 text-sm mb-10 max-w-xl">{t.pillarsIntro}</p>
    <div class="grid md:grid-cols-3 gap-6">
      {t.pillars.map((p, i) => (
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all group">
          <div class="mb-5 flex justify-center">
            <Glyph name={(['biological', 'digital', 'qualia'] as const)[i]} size={96} class="group-hover:scale-105 transition-transform duration-300" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">{p.title}</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">{p.desc}</p>
          <a href={`${prefix}${p.href}`} class="label-mono text-[11px] text-csr-primary hover:underline underline-offset-4">{p.link}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── The Approach ──────────────────────────────────────────────────────── -->
<section class="relative py-16 border-t border-csr-gray-200 overflow-hidden">
  <SymmetryBackground variant="wave" opacity={0.09} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-10"><SectionMark /><p class="label-mono">{t.approachLabel}</p></div>
    <div class="grid md:grid-cols-3 gap-6">
      {t.approach.map(([title, desc], i) => (
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-4 flex justify-center">
            <Glyph name={(['symmetry-axis', 'invariant', 'measurement'] as const)[i]} size={56} />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">{title}</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── Theoretical Foundations ───────────────────────────────────────────── -->
<section class="relative py-16 border-t border-csr-gray-200 overflow-hidden">
  <SymmetryBackground variant="lattice" opacity={0.075} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-3"><SectionMark /><p class="label-mono">{t.foundLabel}</p></div>
    <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">{t.foundIntro}</p>
    <div class="grid sm:grid-cols-2 gap-4">
      {t.papers.map(([title, desc], i) => (
        <a href={`${prefix}/reports/${slugs[i]}/`} class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">Working Paper 0{i + 1}</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">{title}</h4>
            <p class="text-xs text-csr-gray-500 mt-1">{desc}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="mt-6">
      <a href={`${prefix}/reports/`} class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">{t.allReports}</a>
    </div>
  </div>
</section>

<!-- ── References ───────────────────────────────────────────────────────── -->
<section class="py-16 border-t border-csr-gray-200 bg-csr-gray-50/30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-6"><SectionMark /><p class="label-mono">{t.refsLabel}</p></div>
    <ol class="space-y-4 max-w-3xl">
      <li id="ref-i1" class="flex gap-3 text-xs text-csr-gray-600 leading-relaxed">
        <span class="shrink-0 font-mono text-csr-primary">[1]</span>
        <span>Anthis, J. R. et al. (2025). <em>Perceptions of Sentient AI and Other Digital Minds: Evidence from the AI, Morality, and Sentience (AIMS) Survey.</em> CHI 2025. <a href="https://dl.acm.org/doi/10.1145/3706598.3713329" target="_blank" rel="noopener noreferrer" class="text-csr-primary hover:underline break-all">https://dl.acm.org/doi/10.1145/3706598.3713329</a></span>
      </li>
      <li id="ref-i2" class="flex gap-3 text-xs text-csr-gray-600 leading-relaxed">
        <span class="shrink-0 font-mono text-csr-primary">[2]</span>
        <span>Butlin, P. et al. (2023). <em>Consciousness in Artificial Intelligence: Insights from the Science of Consciousness.</em> arXiv. <a href="https://arxiv.org/abs/2308.08708" target="_blank" rel="noopener noreferrer" class="text-csr-primary hover:underline break-all">https://arxiv.org/abs/2308.08708</a></span>
      </li>
    </ol>
  </div>
</section>

<!-- ── CTA ───────────────────────────────────────────────────────────────── -->
<section class="py-16 border-t border-csr-gray-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white border border-csr-gray-100 rounded-3xl shadow-card p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-xl">
        <p class="label-mono mb-3">{t.ctaLabel}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-csr-black mb-3 leading-tight">{t.ctaH2}</h2>
        <p class="text-csr-gray-600 text-sm leading-relaxed">{t.ctaBody}</p>
      </div>
      <div class="shrink-0 flex flex-col gap-3">
        <a href={`${prefix}/donate/`} class="btn-primary whitespace-nowrap">{t.ctaBtn1}</a>
        <a href={`${prefix}/program/`} class="btn-secondary whitespace-nowrap text-center">{t.ctaBtn2}</a>
      </div>
    </div>
  </div>
</section>
