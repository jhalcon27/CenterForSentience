---
import SymmetryBackground from './SymmetryBackground.astro';
import SectionMark from './SectionMark.astro';
import Glyph from './Glyph.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const reproductions = await getCollection('reproductions', ({ data }: CollectionEntry<'reproductions'>) => !data.draft);
const latestReproductions = reproductions
  .sort((a: CollectionEntry<'reproductions'>, b: CollectionEntry<'reproductions'>) => b.data.updated.getTime() - a.data.updated.getTime())
  .slice(0, 3);

const statusLabels: Record<string, { label: string; class: string }> = {
  'in-progress': { label: 'In progress', class: 'bg-amber-100 text-amber-800 border-amber-200' },
  'done': { label: 'Done', class: 'bg-emerald-100 text-emerald-800 border-emerald-200' },
  'abandoned': { label: 'Abandoned', class: 'bg-csr-gray-100 text-csr-gray-600 border-csr-gray-200' },
};

const workingPapers = [
  {
    title: 'First Principles of Sentience Research',
    desc: 'Foundational framework for substrate-neutral modeling of welfare-relevant structure.',
    href: '/reports/first-principles/',
    num: '01',
  },
  {
    title: 'Bio-Electric Fields as Sentience Substrates',
    desc: 'Bioelectric signaling as a candidate physical basis for welfare-relevant states.',
    href: '/reports/bio-electric-fields/',
    num: '02',
  },
  {
    title: 'Assembly Theory as a Metric for Sentience',
    desc: 'Applying assembly index to complexity thresholds in welfare-relevant systems.',
    href: '/reports/assembly-theory/',
    num: '03',
  },
  {
    title: 'Symmetry Landscapes of Valenced Experience',
    desc: 'A mathematically grounded symmetry and spectral framework for MLP transformation layers in LLMs.',
    href: '/reports/symmetry-landscapes/',
    num: '04',
  },
];
---

<!-- ── Hero ────────────────────────────────────────────────────────────────── -->
<section class="relative pt-24 pb-20 border-b border-csr-gray-200 overflow-hidden">
  <SymmetryBackground variant="rings" opacity={0.09} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-6">
      <SectionMark />
      <span class="label-mono">Independent Research · Zurich</span>
    </div>
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-csr-black mb-8 leading-[1.1]">
      Reproducing mechanistic interpretability to measure internal model states.
    </h1>
    <p class="text-xl text-csr-gray-700 leading-relaxed max-w-3xl font-serif mb-8">
      The Center for Sentience Research (CSR) is an independent, unfunded research project run by Jhonatan Serna in Zurich. We reproduce published interpretability findings, working toward original research on whether internal states of computational models can be measured.
    </p>
    <div class="flex flex-wrap items-center gap-4 text-sm font-medium">
      <a href="/reproductions/" class="btn-primary">
        Explore Reproductions →
      </a>
      <a href="/research/" class="btn-secondary">
        Long-Term Agenda
      </a>
    </div>
  </div>
</section>

<!-- ── Reproductions Section ─────────────────────────────────────────────── -->
<section class="py-16 border-b border-csr-gray-200 bg-white/40">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <SectionMark />
          <p class="label-mono">Current Focus</p>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-csr-black">
          Reproductions
        </h2>
      </div>
      <a href="/reproductions/" class="text-xs font-mono text-csr-primary hover:underline hidden sm:inline-block">
        All reproductions →
      </a>
    </div>

    {latestReproductions.length === 0 ? (
      <div class="glass-card rounded-2xl p-8 md:p-10 border border-csr-gray-200">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-medium bg-amber-50 text-amber-800 border border-amber-200">
            First write-up in progress
          </span>
          <span class="text-xs font-mono text-csr-gray-400">Weekly cadence</span>
        </div>
        <h3 class="text-xl font-bold text-csr-black mb-2">
          Induction Heads (Olsson et al., 2022)
        </h3>
        <p class="text-csr-gray-600 font-serif leading-relaxed mb-6">
          We reproduce published mechanistic interpretability results one paper at a time. The first active write-up investigates induction heads and in-context learning circuits in transformer language models, replicating core mechanistic claims and verifying circuit formation.
        </p>
        <div class="flex flex-wrap items-center gap-4 text-xs font-mono">
          <a href="/reproductions/rss.xml" class="text-csr-primary hover:underline flex items-center gap-1.5 font-semibold">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93v-2.83Z"/>
            </svg>
            Subscribe via RSS
          </a>
          <span class="text-csr-gray-300">·</span>
          <a href="/reproductions/" class="text-csr-gray-500 hover:text-csr-black">
            View reproductions index →
          </a>
        </div>
      </div>
    ) : (
      <div class="space-y-4">
        {latestReproductions.map((item) => {
          const st = statusLabels[item.data.status] ?? statusLabels['in-progress'];
          return (
            <article class="glass-card rounded-2xl p-6 border border-csr-gray-200 hover:border-csr-primary/30 transition-all">
              <div class="flex items-center justify-between gap-3 mb-2">
                <span class={`px-2.5 py-0.5 rounded-full text-xs font-mono font-medium border ${st.class}`}>
                  {st.label}
                </span>
                <span class="text-xs font-mono text-csr-gray-400">
                  {item.data.updated.toISOString().slice(0, 10)}
                </span>
              </div>
              <h3 class="text-xl font-bold text-csr-black mb-2">
                <a href={`/reproductions/${item.slug}/`} class="hover:text-csr-primary transition-colors">
                  {item.data.title}
                </a>
              </h3>
              <p class="text-sm text-csr-gray-600 font-serif mb-4">
                {item.data.claim}
              </p>
              <a href={`/reproductions/${item.slug}/`} class="text-xs font-mono text-csr-primary hover:underline font-semibold">
                Read reproduction →
              </a>
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>

<!-- ── Long-term Direction ────────────────────────────────────────────────── -->
<section class="py-16 border-b border-csr-gray-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-3">
      <SectionMark />
      <p class="label-mono">Long-Term Direction</p>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-csr-black mb-6">
      Toward measuring internal states
    </h2>
    <div class="glass-card rounded-2xl p-8 border border-csr-gray-200">
      <p class="text-lg text-csr-gray-700 font-serif leading-relaxed mb-6">
        Beyond individual circuit reproductions, CSR's long-term objective is investigating whether internal states of artificial neural networks can be reliably measured. We examine representation geometry, state-space trajectories, and spectral metrics across MLP layers to determine whether structural invariants track coherent internal dynamics rather than training-distribution artifacts. Public interest in machine sentience continues to evolve,<sup><a href="#ref-1" class="text-csr-primary hover:underline">[1]</a></sup> making empirical, non-verbal measurement tools essential.<sup><a href="#ref-2" class="text-csr-primary hover:underline">[2]</a></sup>
      </p>
      <a href="/research/" class="text-sm font-semibold text-csr-primary hover:underline inline-flex items-center gap-1 font-mono">
        Explore the long-term research agenda →
      </a>
    </div>
  </div>
</section>

<!-- ── Working Papers Section ─────────────────────────────────────────────── -->
<section class="py-16 border-b border-csr-gray-200 bg-white/40">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <SectionMark />
          <p class="label-mono">Theoretical Scaffolding</p>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-csr-black">
          Working papers
        </h2>
      </div>
      <a href="/reports/" class="text-xs font-mono text-csr-primary hover:underline hidden sm:inline-block">
        All working papers →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {workingPapers.map((paper) => (
        <a
          href={paper.href}
          class="glass-card rounded-2xl p-6 border border-csr-gray-200 hover:border-csr-primary/30 transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-csr-primary font-semibold">
                Working Paper {paper.num}
              </span>
              <Glyph />
            </div>
            <h3 class="text-lg font-bold text-csr-black group-hover:text-csr-primary transition-colors mb-2">
              {paper.title}
            </h3>
            <p class="text-sm text-csr-gray-600 font-serif leading-relaxed">
              {paper.desc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-csr-gray-100 text-xs font-mono text-csr-primary group-hover:underline">
            Read paper →
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ── References ──────────────────────────────────────────────────────────── -->
<section class="py-12 border-b border-csr-gray-200 bg-csr-cream">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="label-mono text-xs mb-4">References</p>
    <div class="space-y-3 text-xs text-csr-gray-500 font-mono leading-relaxed">
      <p id="ref-1">
        [1] Anthis, J. R. et al. (2025). <em>Perceptions of Sentient AI and Other Digital Minds: Evidence from the AI, Morality, and Sentience (AIMS) Survey.</em> CHI 2025. <a href="https://dl.acm.org/doi/10.1145/3706598.3713329" target="_blank" rel="noopener noreferrer" class="text-csr-primary hover:underline break-all">https://dl.acm.org/doi/10.1145/3706598.3713329</a>
      </p>
      <p id="ref-2">
        [2] Butlin, P. et al. (2023). <em>Consciousness in Artificial Intelligence: Insights from the Science of Consciousness.</em> arXiv. <a href="https://arxiv.org/abs/2308.08708" target="_blank" rel="noopener noreferrer" class="text-csr-primary hover:underline break-all">https://arxiv.org/abs/2308.08708</a>
      </p>
    </div>
  </div>
</section>
