      <circle cx="15" cy="12" r="1.5" fill="#9966CC"/><circle cx="45" cy="12" r="1.5" fill="#9966CC"/><circle cx="75" cy="12" r="1.5" fill="#9966CC"/><circle cx="105" cy="12" r="1.5" fill="#9966CC"/><circle cx="135" cy="12" r="1.5" fill="#9966CC"/><circle cx="165" cy="12" r="1.5" fill="#9966CC"/><circle cx="195" cy="12" r="1.5" fill="#9966CC"/><circle cx="225" cy="12" r="1.5" fill="#9966CC"/><circle cx="255" cy="12" r="1.5" fill="#9966CC"/><circle cx="285" cy="12" r="1.5" fill="#9966CC"/><circle cx="315" cy="12" r="1.5" fill="#9966CC"/><circle cx="345" cy="12" r="1.5" fill="#9966CC"/><circle cx="375" cy="12" r="1.5" fill="#9966CC"/><circle cx="405" cy="12" r="1.5" fill="#9966CC"/><circle cx="435" cy="12" r="1.5" fill="#9966CC"/><circle cx="465" cy="12" r="1.5" fill="#9966CC"/><circle cx="495" cy="12" r="1.5" fill="#9966CC"/><circle cx="525" cy="12" r="1.5" fill="#9966CC"/><circle cx="555" cy="12" r="1.5" fill="#9966CC"/><circle cx="585" cy="12" r="1.5" fill="#9966CC"/>
