---
interface Props {
  variant?: 'lissajous' | 'matrix';
  opacity?: number;
}
const { variant = 'lissajous', opacity = 0.05 } = Astro.props;
---

{variant === 'lissajous' && (
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <svg
      class="absolute -top-1/4 -right-1/4 w-[80vw] max-w-[900px] h-auto"
      viewBox="0 0 800 800"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      style={`opacity: ${opacity}`}
    >
      <ellipse cx="400" cy="400" rx="360" ry="200" stroke="#9966CC" stroke-width="1.5" transform="rotate(0 400 400)"/>
      <ellipse cx="400" cy="400" rx="280" ry="160" stroke="#9966CC" stroke-width="1.5" transform="rotate(30 400 400)"/>
      <ellipse cx="400" cy="400" rx="200" ry="120" stroke="#9966CC" stroke-width="1.5" transform="rotate(60 400 400)"/>
      <ellipse cx="400" cy="400" rx="130" ry="80" stroke="#9966CC" stroke-width="1.5" transform="rotate(90 400 400)"/>
      <ellipse cx="400" cy="400" rx="70" ry="40" stroke="#9966CC" stroke-width="1.5" transform="rotate(120 400 400)"/>
      <line x1="400" y1="40" x2="400" y2="760" stroke="#9966CC" stroke-width="0.75" stroke-dasharray="4 8"/>
      <line x1="40" y1="400" x2="760" y2="400" stroke="#9966CC" stroke-width="0.75" stroke-dasharray="4 8"/>
      <line x1="143" y1="143" x2="657" y2="657" stroke="#9966CC" stroke-width="0.75" stroke-dasharray="4 8"/>
      <line x1="657" y1="143" x2="143" y2="657" stroke="#9966CC" stroke-width="0.75" stroke-dasharray="4 8"/>
      <circle cx="400" cy="400" r="4" fill="#9966CC"/>
    </svg>
  </div>
)}

