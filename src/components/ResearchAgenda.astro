    foundationalIntro: 'Working papers that provide the theoretical scaffolding for the Digital Valence Program.',
    allReports: 'All reports →',
    wp: ['First Principles of Sentience Research', 'Bio-Electric Fields as Sentience Substrates', 'Assembly Theory as a Metric for Sentience', 'Symmetry Landscapes of Valenced Experience'],
