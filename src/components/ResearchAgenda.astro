const t = L[lang] ?? L.en;
const wpSlugs = ['first-principles', 'bio-electric-fields', 'assembly-theory', 'symmetry-landscapes'];
---

<!-- ── Header ────────────────────────────────────────────────────────────── -->
<section class="relative pt-20 pb-14 border-b border-csr-gray-200 overflow-hidden">
  <SymmetryBackground variant="lissajous" opacity={0.085} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="label-mono mb-4">{t.eyebrow}</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-3xl leading-tight">
      The Digital Valence Program
    </h1>
    <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif" set:html={t.intro}></p>
  </div>
</section>

<!-- ── Question navigation ───────────────────────────────────────────────── -->
<section class="py-8 border-b border-csr-gray-200 bg-csr-gray-50/30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <ol class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3 text-sm">
      {['mission', 'measurement', 'mechanisms', 'intervention', 'substrate'].map((anchor, i) => (
        <li><a href={`#${anchor}`} class="flex flex-col gap-1 p-3 rounded-xl hover:bg-white hover:shadow-card transition-all"><span class="label-mono text-[10px] text-csr-primary">Q{i + 1}</span><span class="font-semibold text-csr-black">{t.nav[i]}</span></a></li>
      ))}
    </ol>
  </div>
</section>

<!-- ══ Q1 · MISSION ══════════════════════════════════════════════════════════ -->
<section class="py-16" id="mission">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-3"><SectionMark /><p class="label-mono">{t.q1.eyebrow}</p></div>
    <h2 class="text-2xl md:text-3xl font-bold text-csr-black mb-6 max-w-2xl leading-tight">{t.q1.q}</h2>

    <div class="max-w-2xl space-y-5 font-serif text-csr-gray-600 leading-relaxed text-base mb-10">
      <p set:html={t.q1.p1}></p>
      <p set:html={t.q1.p2}></p>
    </div>

    <div class="max-w-3xl space-y-6">
      <p class="text-sm font-mono text-csr-gray-500 uppercase tracking-wider">{t.q1.chainLabel}</p>
      <p class="text-sm text-csr-gray-600 leading-relaxed font-serif">{t.q1.chainIntro}</p>
      <div class="space-y-3">
        {t.q1.steps.map((step: [string, string], i: number) => (
          <div class="flex gap-4 items-start">
            <span class="shrink-0 w-6 h-6 rounded-full bg-csr-primary/10 text-csr-primary text-xs font-mono flex items-center justify-center mt-0.5">{i + 1}</span>
            <div>
              <p class="text-sm font-bold text-csr-black">{step[0]}</p>
              <p class="text-xs text-csr-gray-600 leading-relaxed">{step[1]}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="bg-amber-50/60 border border-amber-200 rounded-2xl p-6 mt-4">
        <h4 class="text-xs font-mono text-amber-900 font-bold uppercase mb-2">{t.q1.weakestTitle}</h4>
        <p class="text-sm text-amber-800 leading-relaxed">{t.q1.weakestBody}</p>
      </div>
    </div>

    <div class="max-w-3xl mt-12">
      <p class="text-sm font-mono text-csr-gray-500 uppercase tracking-wider mb-2">{t.q1.calibLabel}</p>
      <p class="text-sm text-csr-gray-600 leading-relaxed font-serif mb-6">{t.q1.calibIntro}</p>
      <CalibrationBar lang={lang} />
    </div>
  </div>
</section>

<!-- ══ Q2 · MEASUREMENT ══════════════════════════════════════════════════════ -->
<section class="py-16 border-t border-csr-gray-200 bg-csr-gray-50/30" id="measurement">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-3"><SectionMark /><p class="label-mono">{t.q2.eyebrow}</p></div>
    <h2 class="text-2xl md:text-3xl font-bold text-csr-black mb-6 max-w-2xl leading-tight">{t.q2.q}</h2>
    <p class="text-base text-csr-gray-600 leading-relaxed font-serif max-w-2xl mb-10">{t.q2.intro}</p>

    <div class="grid md:grid-cols-2 gap-6 max-w-3xl mb-8">
      <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
        <div class="mb-5 flex justify-center"><Glyph name="invariant" size={56} /></div>
        <h3 class="font-bold text-csr-black mb-2 text-sm">{t.q2.microTitle}</h3>
        <p class="text-xs text-csr-gray-600 leading-relaxed">{t.q2.microDesc}</p>
      </div>
      <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
        <div class="mb-5 flex justify-center"><Glyph name="measurement" size={56} /></div>
        <h3 class="font-bold text-csr-black mb-2 text-sm">{t.q2.macroTitle}</h3>
        <p class="text-xs text-csr-gray-600 leading-relaxed">{t.q2.macroDesc}</p>
      </div>
    </div>

    <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card max-w-3xl">
      <p class="label-mono text-[10px] text-csr-primary mb-2">{t.q2.methodLabel}</p>
      <h3 class="font-bold text-csr-black mb-3 text-base">{t.q2.methodTitle}</h3>
      <p class="text-sm text-csr-gray-600 leading-relaxed" set:html={t.q2.methodBody}></p>
    </div>
  </div>
</section>

<!-- ══ Q3 · MECHANISMS ═══════════════════════════════════════════════════════ -->
<section class="relative py-16 border-t border-csr-gray-200 overflow-hidden" id="mechanisms">
  <SymmetryBackground variant="spiral" opacity={0.08} />
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-3"><SectionMark /><p class="label-mono">{t.q3.eyebrow}</p></div>
    <h2 class="text-2xl md:text-3xl font-bold text-csr-black mb-6 max-w-2xl leading-tight">{t.q3.q}</h2>
    <p class="text-base text-csr-gray-600 leading-relaxed font-serif max-w-2xl mb-8">{t.q3.intro}</p>

    <div class="max-w-3xl mb-10">
      <ValenceCurve lang={lang} caption={t.q3.curveCaption} />
