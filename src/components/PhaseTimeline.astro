---
/**
 * PhaseTimeline.astro
 * Horizontal three-phase progress track for the 2026 program. Status is shown
 * by node fill + a text label (not color alone), with a progress line up to the
 * current phase. Matches the phase scheme used in ProgramStatus.
 */
interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

const L: Record<string, { roadmap: string; target: string; rows: [string, string][] }> = {
  en: { roadmap: 'Program roadmap', target: 'Target: end of 2026', rows: [['Literature synthesis', 'In progress'], ['Formal workspace definition', 'Pending'], ['Empirical validation', 'Pending']] },
};
const t = L[lang] ?? L.en;
const states = ['active', 'pending', 'pending'];
const phases = t.rows.map(([title, status], i) => ({ n: `0${i + 1}`, title, status, state: states[i] }));
---

<div class="rounded-2xl border border-csr-gray-200 bg-white shadow-card p-6 md:p-8">
  <div class="flex items-baseline justify-between mb-8">
    <p class="text-xs font-mono uppercase tracking-[0.2em] text-csr-gray-500">{t.roadmap}</p>
    <p class="text-[11px] font-mono text-csr-gray-400">{t.target}</p>
  </div>

  <div class="relative">
    <!-- base track -->
    <div class="absolute left-0 right-0 top-2 h-0.5 bg-csr-gray-200"></div>
    <!-- progress fill: partway through phase 1 (the current phase) -->
    <div class="absolute left-0 top-2 h-0.5 bg-csr-primary" style="width:16%"></div>

    <ol class="relative grid grid-cols-3 gap-4">
      {phases.map((p) => (
        <li class="flex flex-col items-start">
          {p.state === 'active' ? (
            <span class="w-4 h-4 rounded-full bg-csr-primary ring-4 ring-csr-primary/20 shrink-0 -ml-0.5"></span>
          ) : p.state === 'done' ? (
            <span class="w-4 h-4 rounded-full bg-csr-primary shrink-0 -ml-0.5"></span>
          ) : (
            <span class="w-4 h-4 rounded-full bg-csr-cream border-2 border-csr-gray-300 shrink-0 -ml-0.5"></span>
          )}
          <span class="label-mono text-[10px] mt-4">{p.n}</span>
          <span class={`text-sm font-bold mt-1 leading-snug ${p.state === 'pending' ? 'text-csr-gray-400' : 'text-csr-black'}`}>{p.title}</span>
          <span class={`text-[11px] font-mono mt-1 ${p.state === 'pending' ? 'text-csr-gray-400' : 'text-csr-primary'}`}>{p.status}</span>
        </li>
      ))}
    </ol>
  </div>
</div>
