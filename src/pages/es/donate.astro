---
import Layout from '../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="Apoyo a la misión" description="Apoye al Center for Sentience Research a través de donaciones deducibles de impuestos y asociaciones estratégicas.">
  <section class="py-12 bg-[#FFF8F0]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-[#9966CC] font-mono text-xs uppercase tracking-widest mb-4">Apoyo Estratégico</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        Asociación para <span class="text-gradient">investigación de alto impacto</span>
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        El Center for Sentience Research (CSR) cuenta con el apoyo de una comunidad de visionarios, filántropos e instituciones de investigación dedicadas a resolver el problema difícil de la conciencia.
      </p>
    </div>
  </section>
</Layout>
