---
import Layout from '../../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="Primeros Principios de la Investigación sobre la Sentiencia" description="Marco fundamental para modelar la consciencia en todos los sustratos.">
  <article class="py-12 max-w-4xl mx-auto px-4">
    <p class="text-[#9966CC] font-mono text-xs uppercase tracking-widest mb-4">Documento Fundacional — CSR-WP-01</p>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">Primeros Principios de la Investigación sobre la Sentiencia</h1>
    <div class="prose prose-slate">
      <p><em>Contenido en desarrollo.</em></p>
    </div>
  </article>
</Layout>
