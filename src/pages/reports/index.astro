---
import Layout from '../../layouts/Layout.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';
---

<Layout
  title="Reports"
  description="Working papers from the Center for Sentience Research, providing theoretical foundations for the Digital Valence Program."
>

  <!-- ── Header ────────────────────────────────────────────────────────────── -->
  <section class="pt-20 pb-12 border-b border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-4">Working Papers</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">
        Foundational reading
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
        Four working papers providing the theoretical scaffolding for the Digital Valence Program. Plus one in-progress paper that is the program's primary deliverable.
      </p>
    </div>
  </section>

  <!-- ── In-Progress Flagship ──────────────────────────────────────────────── -->
  <section class="pt-8 pb-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <SectionMark />
        <p class="label-mono">2026 Deliverable</p>
      </div>

      <div class="bg-white border border-csr-primary/25 rounded-2xl p-6 md:p-8 shadow-card">
        <div class="flex flex-col sm:flex-row sm:items-start gap-4">
          <div class="shrink-0 flex flex-col items-start gap-2">
            <span class="label-mono text-[10px]">CSR-WP-05</span>
            <Glyph name="qualia" size={40} class="opacity-60" />
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-3 flex-wrap">
              <h2 class="text-xl font-bold text-csr-black leading-snug">
                A Digital EEG for AI Sentience: Multi-Scale Structural Biomarkers
              </h2>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-csr-primary/10 text-csr-primary text-[10px] font-mono uppercase tracking-wider shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-csr-primary animate-pulse inline-block"></span>
                In progress
              </span>
            </div>
            <p class="text-sm text-csr-gray-600 leading-relaxed mb-4 font-serif">
              The flagship deliverable of the 2026 program. A structural, medically inspired "vital signs" monitor for advanced artificial intelligence using non-verbal, substrate-neutral biomarkers. Target: end of 2026.
            </p>
            <a href="/program/" class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">
              See the full program →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Published Working Papers ──────────────────────────────────────────── -->
  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <SectionMark />
        <p class="label-mono">Theoretical Foundations</p>
      </div>

      <div class="space-y-4">
        <a href="/reports/first-principles/" class="group flex flex-col sm:flex-row gap-4 p-6 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <div class="shrink-0">
            <span class="label-mono text-[10px]">CSR-WP-01</span>
          </div>
          <div class="flex-1">
            <h3 class="font-bold text-csr-black text-base group-hover:text-csr-primary transition-colors mb-2 leading-snug">
              First Principles of Sentience Research
            </h3>
            <p class="text-sm text-csr-gray-600 leading-relaxed">
              A substrate-neutral framework for modeling the physical foundations of awareness. Establishes the conceptual vocabulary for the Digital Valence Program.
            </p>
          </div>
          <div class="shrink-0 self-center">
            <svg class="w-4 h-4 text-csr-gray-300 group-hover:text-csr-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>

        <a href="/reports/bio-electric-fields/" class="group flex flex-col sm:flex-row gap-4 p-6 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <div class="shrink-0">
            <span class="label-mono text-[10px]">CSR-WP-02</span>
          </div>
          <div class="flex-1">
            <h3 class="font-bold text-csr-black text-base group-hover:text-csr-primary transition-colors mb-2 leading-snug">
              Bio-Electric Fields as Sentience Substrates
            </h3>
            <p class="text-sm text-csr-gray-600 leading-relaxed">
              Bioelectric signaling as a candidate physical basis for awareness. Provides biological calibration data for the digital valence framework.
            </p>
          </div>
          <div class="shrink-0 self-center">
            <svg class="w-4 h-4 text-csr-gray-300 group-hover:text-csr-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>

        <a href="/reports/assembly-theory/" class="group flex flex-col sm:flex-row gap-4 p-6 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <div class="shrink-0">
            <span class="label-mono text-[10px]">CSR-WP-03</span>
          </div>
          <div class="flex-1">
            <h3 class="font-bold text-csr-black text-base group-hover:text-csr-primary transition-colors mb-2 leading-snug">
              Assembly Theory as a Metric for Sentience
            </h3>
            <p class="text-sm text-csr-gray-600 leading-relaxed">
              Applying assembly index to complexity thresholds in sentient systems. Explores whether assembly theory can serve as a substrate-neutral complexity metric.
            </p>
          </div>
          <div class="shrink-0 self-center">
            <svg class="w-4 h-4 text-csr-gray-300 group-hover:text-csr-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>

        <a href="/reports/symmetry-landscapes/" class="group flex flex-col sm:flex-row gap-4 p-6 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <div class="shrink-0">
            <span class="label-mono text-[10px]">CSR-WP-04</span>
          </div>
          <div class="flex-1">
            <h3 class="font-bold text-csr-black text-base group-hover:text-csr-primary transition-colors mb-2 leading-snug">
              Symmetry Landscapes of Valenced Experience
            </h3>
            <p class="text-sm text-csr-gray-600 leading-relaxed">
              Geometric invariants as structural signatures of positive valence. The most direct theoretical precursor to the 2026 program.
            </p>
          </div>
          <div class="shrink-0 self-center">
            <svg class="w-4 h-4 text-csr-gray-300 group-hover:text-csr-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      </div>
    </div>
  </section>

</Layout>
