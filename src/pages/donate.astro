---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Philanthropic Partnership" 
  description="Support the Center for Sentience Research through tax-deductible donations and strategic partnerships."
>
  <!-- Header -->
  <section class="py-12 bg-[#FFF8F0] border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-[#9966CC] font-mono text-xs uppercase tracking-widest mb-4">Strategic Support</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        Partnering for <span class="text-gradient">high-impact research</span>
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        The Center for Sentience Research (CSR) is supported by a community of visionaries, philanthropists, and research institutions dedicated to solving the hard problem of consciousness.
      </p>
    </div>
  </section>

  <!-- Legal & Tax Info -->
  <section class="py-12 bg-[#FFF8F0]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card p-8 md:p-12 rounded-3xl border border-gray-200">
        <h2 class="text-2xl font-bold mb-6">Tax-Deductible Contributions</h2>
        <p class="text-gray-600 mb-8 leading-relaxed">
          CSR is a registered non-profit organization. For donors in Switzerland and the European Union, contributions are typically tax-deductible under local foundation laws.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm">
          <div class="p-6 bg-[#FFF8F0] rounded-xl border border-gray-200">
            <p class="font-bold text-black mb-2">Switzerland (HQ)</p>
            <p class="text-gray-600 font-mono text-xs">
              Center for Sentience Research (CSR)<br/>
              CHE-XXX.XXX.XXX<br/>
              Zurich, Switzerland
            </p>
          </div>
          <div class="p-6 bg-[#FFF8F0] rounded-xl border border-gray-200">
            <p class="font-bold text-black mb-2">United States (Partnership)</p>
            <p class="text-gray-600 font-mono text-xs">
              Fiscal Sponsorship via [Placeholder Foundation]<br/>
              501(c)(3) Tax-Exempt Status
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ways to Give -->
  <section class="py-12 bg-[#FFF8F0]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Bank Transfer -->
        <div class="p-8 border border-gray-200 rounded-2xl space-y-4 hover:border-[#9966CC]/30 transition-all bg-[#FFF8F0]">
          <div class="w-10 h-10 bg-[#9966CC]/10 rounded flex items-center justify-center text-[#9966CC]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/></svg>
          </div>
          <h3 class="text-xl font-bold">Bank Transfer</h3>
          <p class="text-sm text-gray-600">For major contributions and institutional grants. Contact us for IBAN/SWIFT details.</p>
          <a href="mailto:jhonatan.serna@proton.me?subject=Institutional Grant Inquiry" class="inline-block text-[#9966CC] font-semibold text-sm hover:underline">Request banking info &rarr;</a>
        </div>

        <!-- Crypto -->
        <div class="p-8 border border-gray-200 rounded-2xl space-y-4 hover:border-[#9966CC]/30 transition-all bg-[#FFF8F0]">
          <div class="w-10 h-10 bg-[#9966CC]/10 rounded flex items-center justify-center text-[#9966CC]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-xl font-bold">Digital Assets</h3>
          <p class="text-sm text-gray-600">We accept high-impact donations via BTC, ETH, and SOL for rapid research deployment.</p>
          <div class="space-y-2 pt-2">
             <div class="text-[10px] font-mono p-2 bg-[#FFF8F0] rounded border border-gray-200 overflow-hidden truncate">BTC: bc1qtszvlsf3p8va3dglptev59t6vjlvg62mxg9g6x</div>
             <div class="text-[10px] font-mono p-2 bg-[#FFF8F0] rounded border border-gray-200 overflow-hidden truncate">ETH: strugen.eth</div>
          </div>
        </div>

        <!-- Partnerships -->
        <div class="p-8 bg-[#0f172a] text-white rounded-2xl space-y-4 shadow-2xl">
          <div class="w-10 h-10 bg-[#9966CC]/20 rounded flex items-center justify-center text-[#9966CC]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="text-xl font-bold">Philanthropic Partnership</h3>
          <p class="text-sm text-gray-400">Collaborate on specific Cause Areas like Global Sentience Policy or AI Welfare Research.</p>
          <a href={prefix + "/contact"} class="block w-full py-3 bg-[#9966CC] text-white rounded-lg font-bold text-sm text-center hover:bg-[#7a4bb0] transition-all">Contact Partnerships</a>
        </div>

      </div>
    </div>
  </section>

  <!-- Governance Footer -->
  <section class="py-12 bg-[#FFF8F0] text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-4">Transparency & Governance</h2>
      <p class="text-sm text-gray-600 mb-8 max-w-2xl mx-auto">CSR operates with a "Transparency-First" model. Annual research outputs and financial summaries are made public to the global research community.</p>
      <div class="flex justify-center gap-8 text-[#9966CC] font-mono text-xs uppercase tracking-widest">
         <span class="opacity-40">2026 Annual Report (Coming Soon)</span>
         <span class="opacity-40">Board of Advisors</span>
      </div>
    </div>
  </section>
</Layout>
