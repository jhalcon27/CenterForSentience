---
import Layout from '../layouts/Layout.astro';
import ProgramStatus from '../components/ProgramStatus.astro';
import SectionMark from '../components/SectionMark.astro';
import Glyph from '../components/Glyph.astro';
import SymmetryBackground from '../components/SymmetryBackground.astro';
import BudgetChart from '../components/BudgetChart.astro';
---

<Layout
  title="Fund the Valence Program"
  description="Support the Center for Sentience Research 2026 program: a formal mathematical framework for measuring the geometric property STV associates with valence in digital minds."
>

  <!-- ── Header ────────────────────────────────────────────────────────────── -->
  <section class="relative pt-20 pb-12 border-b border-csr-gray-200 overflow-hidden">
    <SymmetryBackground variant="rings" opacity={0.09} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-4">Fund the Program</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">
        The measurement tools need to exist before the question becomes urgent.
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
        If scaled neural computation can give rise to states with positive or negative character, we should know how to recognize them. Your contribution funds the 2026 deliverable: a formal mathematical framework for measuring the geometric property STV associates with valence in digital minds.
      </p>
    </div>
  </section>

  <!-- ── Program Status ────────────────────────────────────────────────────── -->
  <section class="py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <SectionMark />
        <p class="label-mono">What You're Funding</p>
      </div>
      <ProgramStatus />
      <div class="mt-6">
        <a href="/program/" class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">
          Full program details →
        </a>
      </div>
    </div>
  </section>

  <!-- ── Budget breakdown ──────────────────────────────────────────────────── -->
  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">Budget Breakdown</p>
      </div>
      <div class="mb-8">
        <BudgetChart />
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="digital" size={36} class="opacity-60" /></div>
          <p class="label-mono text-[10px] text-csr-gray-400 mb-2">Lean Tier — Floor</p>
          <p class="text-2xl font-bold text-csr-primary mb-2">$110k</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm">Core Research</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">Lead researcher (50% FTE) and one junior ML engineer (50% FTE). Formal mathematical definitions, the core PyTorch simulation engine, and the theoretical whitepaper.</p>
        </div>
        <div class="bg-white border border-csr-primary/30 rounded-2xl p-6 shadow-card ring-1 ring-csr-primary/20">
          <div class="mb-3 flex justify-center"><Glyph name="phase-portrait" size={36} class="opacity-60" /></div>
          <p class="label-mono text-[10px] text-csr-primary mb-2">Recommended — Mainline Request</p>
          <p class="text-2xl font-bold text-csr-primary mb-2">$135k</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm">Full Program</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">Lead researcher (50% FTE) and one junior ML engineer — no postdoc at this tier. Funds the headline cross-linguistic perturbation-recovery experiment: matched aversive-vs-neutral contexts in four languages (ES, DE, SV, EN), measuring internal recovery dynamics and testing cross-language invariance as a state-vs-mimicry discriminator. It runs on modest hardware by design — free infrastructure such as NNsight/NDIF where available, otherwise modest paid cloud GPU — with a reduced paid-compute line covering only custom simulation and fine-tuning that free infrastructure does not. Includes a method plausibility check against invertebrate electrophysiology and connectome data (stomatogastric ganglion, OpenWorm C. elegans) — a sanity check on the method, not a valence anchor — plus field-building and dissemination.</p>
        </div>
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="invariant" size={36} class="opacity-60" /></div>
          <p class="label-mono text-[10px] text-csr-gray-400 mb-2">Stretch Tier — Ambition</p>
          <p class="text-2xl font-bold text-csr-primary mb-2">$260k</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm">Frontier Deployment</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">A full-time team. Pilots the measurement toolkit on larger open-weights frontier models and seeks collaboration with external interpretability labs, using local Jacobian and spectral trajectory metrics on active, large-scale systems. This tier could also support a future postdoc hire (e.g. global-workspace or cognitive science).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Ways to Contribute ────────────────────────────────────────────────── -->
  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">Ways to Contribute</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Bank Transfer -->
        <div class="p-8 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <div class="w-10 h-10 rounded-xl bg-csr-primary/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-csr-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-csr-black mb-2">Bank Transfer</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-5">For major contributions and institutional grants. Contact us for IBAN/SWIFT details.</p>
          <a href="mailto:jhonatan.serna@proton.me?subject=Institutional Grant Inquiry" class="label-mono text-[11px] hover:underline underline-offset-4">Request banking info →</a>
        </div>

        <!-- Digital Assets -->
        <div class="p-8 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <div class="w-10 h-10 rounded-xl bg-csr-primary/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-csr-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-csr-black mb-2">Digital Assets</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-5">We accept BTC, ETH, and SOL for rapid research deployment.</p>
          <div class="space-y-2">
            <div class="text-[10px] font-mono p-2 bg-csr-gray-100 rounded-lg border border-csr-gray-200 overflow-hidden truncate text-csr-gray-500">BTC: bc1qtszvlsf3p8va3dglptev59t6vjlvg62mxg9g6x</div>
            <div class="text-[10px] font-mono p-2 bg-csr-gray-100 rounded-lg border border-csr-gray-200 overflow-hidden truncate text-csr-gray-500">ETH: strugen.eth</div>
          </div>
        </div>

        <!-- Research Partnership -->
        <div class="p-8 bg-white border border-csr-primary/20 rounded-2xl shadow-card">
          <div class="w-10 h-10 rounded-xl bg-csr-primary/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-csr-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-csr-black mb-2">Research Partnership</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-6">Collaborate on the Digital Valence Program, AI welfare research, or long-term measurement infrastructure.</p>
          <a href="/contact/" class="block w-full text-center py-3 bg-csr-primary text-white rounded-full font-semibold text-sm hover:bg-csr-primary-dark transition-all">Contact Partnerships</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Fiscal Sponsorship ────────────────────────────────────────────────── -->
  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <SectionMark />
        <p class="label-mono">Legal Status</p>
      </div>
      <p class="text-csr-gray-600 mb-8 leading-relaxed max-w-2xl">
        The Center for Sentience Research is an independent non-profit in formation, with charitable fiscal sponsorship in progress (pending approval). Once sponsorship is confirmed, contributions may be tax-deductible depending on your jurisdiction — contact us for current details and donation receipts.
      </p>
      <p class="text-xs text-csr-gray-400 font-mono">Annual research outputs and financial summaries are made public. Transparency-First model.</p>
    </div>
  </section>

</Layout>
