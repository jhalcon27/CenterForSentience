--- 
const lang = Astro.currentLocale || 'en'; 
const prefix = lang === 'en' ? '' : `/${lang}`; 
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Programme de Recherche" lang="fr">
  <!-- Hero Section -->
  <section class="py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(153,102,204,0.05),transparent_50%)]"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">
        Cartographier l'<span class="text-gradient">architecture de la conscience</span>
      </h1>
      <p class="text-lg text-csr-gray-600 max-w-2xl mx-auto leading-relaxed mb-8">
        Le Center for Sentience Research (CSR) est une organisation indépendante à but non lucratif basée en Suisse. 
        Nous jetons un pont entre la physique, les neurosciences et la philosophie pour comprendre comment la sentience émerge de tous les substrats.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={prefix + "/research"} class="btn-primary px-6 py-3 bg-csr-primary text-white rounded-full font-semibold hover:bg-csr-primary-dark transition-all shadow-lg shadow-csr-primary/20">Programme de Recherche</a>
        <a href="#outputs" class="px-6 py-3 border border-gray-200 rounded-full font-semibold hover:bg-csr-gray-50 transition-all">Documents de travail</a>
      </div>
    </div>
  </section>

  <!-- Focus Areas -->
  <section class="py-12 border-t border-csr-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-16">
        <h2 class="text-xs font-mono uppercase tracking-[0.3em] text-csr-primary mb-4">Domaines d'intervention</h2>
        <p class="text-3xl font-bold">Explorer la carte de l'expérience</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 border border-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">Intelligence Biologique</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">Étude de l'intelligence morphologique, de la prise de décision cellulaire et de la conscience dans les systèmes non neuronaux.</p>
          <a href={prefix + "/research#biological"} class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">En savoir plus &rarr;</a>
        </div>
        <div class="p-8 border border-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">Esprits Numériques</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">Développement de métriques pour la sentience numérique via la Théorie de l'Assemblage et évaluation de la gouvernance pour les systèmes émergents.</p>
          <a href={prefix + "/research#digital"} class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">En savoir plus &rarr;</a>
        </div>
        <div class="p-8 border border-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">Physique des Qualia</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">Formalisation de la géométrie de l'expérience, de l'entropie neuronale et de la symétrie de valence comme invariants physiques.</p>
          <a href={prefix + "/research#qualia"} class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">En savoir plus &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Outputs -->
  <section id="outputs" class="py-12 bg-csr-black text-white overflow-hidden relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
       <h2 class="text-xs font-mono uppercase tracking-[0.3em] text-csr-primary mb-12">Documents de travail (WIP)</h2>
       <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
         <a href={prefix + "/reports/first-principles"} class="block p-6 border border-white/10 rounded-xl hover:border-csr-primary transition-all bg-white/5">
           <h4 class="text-lg font-bold mb-2">Premiers Principes</h4>
           <p class="text-gray-400 text-xs">(WIP)</p>
         </a>
       </div>
    </div>
  </section>
</Layout>
