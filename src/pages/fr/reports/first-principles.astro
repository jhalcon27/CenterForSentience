---
import Layout from '../../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="Premiers principes de la recherche sur la sentience" description="Cadre fondamental pour modéliser la conscience sur tous les substrats.">
  <article class="py-12 max-w-4xl mx-auto px-4">
    <p class="text-[#9966CC] font-mono text-xs uppercase tracking-widest mb-4">Document fondateur — CSR-WP-01</p>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">Premiers principes de la recherche sur la sentience</h1>
    <div class="prose prose-slate">
      <p><em>Contenu en cours de développement.</em></p>
    </div>
  </article>
</Layout>
