---
import Layout from '../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="Soutien à la mission" description="Soutenez le Center for Sentience Research par le biais de dons déductibles des impôts et de partenariats stratégiques.">
  <section class="py-12 bg-[#FFF8F0]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-[#9966CC] font-mono text-xs uppercase tracking-widest mb-4">Soutien stratégique</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        Partenariat pour une <span class="text-gradient">recherche à fort impact</span>
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        Le Center for Sentience Research (CSR) est soutenu par une communauté de visionnaires, de philanthropes et d'institutions de recherche dédiés à la résolution du problème difficile de la conscience.
      </p>
    </div>
  </section>
</Layout>
