---
import Layout from '../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="Programme de Recherche" description="Les trois piliers de notre enquête sur les fondements physiques de la sentience.">
  <section class="py-12 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-csr-primary font-mono text-xs uppercase tracking-widest mb-4">Programme de Recherche</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        Cartographier l'<span class="text-gradient">architecture de la conscience</span>
      </h1>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href={prefix + "/contact"} class="btn-primary px-8 py-4 bg-csr-primary text-white rounded-full font-semibold hover:bg-csr-primary-dark transition-all">Nous contacter</a>
    </div>
  </section>
</Layout>
