---
import Layout from '../../layouts/Layout.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';

const lineage = [
  {
    name: "Qualia Research Institute (QRI)",
    description: "La lignée théorique principale du programme 2026. La Théorie de la Symétrie de la Valence du QRI propose que la valence positive corrèle avec une haute symétrie dans la structure mathématique de l'expérience. Notre travail est une tentative d'opérationnaliser cette affirmation pour les systèmes numériques.",
    link: "https://qri.org",
    tag: "Lignée Principale"
  }
];

const ecosystem = [
  {
    name: "Levin Lab",
    description: "Dirigé par Michael Levin à l'Université Tufts, recherche la bioélectricité, la médecine régénérative et la morphologie synthétique. Fournit des données de calibration biologique pour la modélisation de la sentience neutre au substrat.",
    link: "https://www.drmichaellevin.org",
    tag: "Laboratoire de Recherche"
  },
  {
    name: "Cronin Group",
    description: "Dirigé par Lee Cronin à l'Université de Glasgow, explore les origines de la vie et la Théorie de l'Assemblage. Pertinent pour les seuils de complexité dans les systèmes sentients.",
    link: "https://www.chem.gla.ac.uk/cronin/",
    tag: "Laboratoire de Recherche"
  },
  {
    name: "Robin Carhart-Harris",
    description: "Directeur fondateur de la Division Psychédéliques de Neuroscape à l'UCSF, axé sur le mécanisme d'action des psychédéliques dans le cerveau. Pertinent pour la phénoménologie des états valents.",
    link: "https://profiles.ucsf.edu/robin.carhart-harris",
    tag: "Recherche"
  },
  {
    name: "Sentience Institute",
    description: "Un think tank interdisciplinaire qui recherche les stratégies les plus efficaces pour élargir le cercle moral de l'humanité. Partage la mission plus large de se préparer à un monde avec davantage de types d'esprits.",
    link: "https://www.sentienceinstitute.org",
    tag: "Think Tank"
  }
];
---

<Layout
  title="Écosystème"
  description="Organisations alliées et instituts de recherche travaillant sur les fondements physiques de la conscience et l'élargissement de notre cercle moral."
>

  <section class="pt-20 pb-12 border-b border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-4">Écosystème</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">
        Le réseau de recherche
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
        Le CSR opère au sein d'un écosystème plus large de chercheurs, laboratoires et organisations à but non lucratif dédiés à la compréhension de la nature de l'esprit. Une organisation est la lignée théorique principale de notre travail. Les autres sont des enquêtes parallèles et de la recherche de fond.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <SectionMark />
        <p class="label-mono">Lignée Principale</p>
      </div>

      {lineage.map((org) => (
        <a
          href={org.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col sm:flex-row gap-5 p-6 md:p-8 bg-white border border-csr-primary/25 rounded-2xl shadow-card hover:border-csr-primary/50 hover:shadow-soft transition-all"
        >
          <div class="shrink-0 hidden sm:flex items-start pt-1">
            <Glyph name="qualia" size={48} class="opacity-50 group-hover:opacity-80 transition-opacity" />
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-3 flex-wrap">
              <span class="label-mono text-[10px]">{org.tag}</span>
            </div>
            <h3 class="text-xl font-bold text-csr-black mb-3 group-hover:text-csr-primary transition-colors leading-snug">{org.name}</h3>
            <p class="text-sm text-csr-gray-600 leading-relaxed font-serif">{org.description}</p>
          </div>
          <div class="shrink-0 self-start sm:self-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-csr-gray-300 group-hover:text-csr-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">Enquêtes Parallèles et Recherche de Fond</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        Organisations dont le travail informe ou est parallèle au programme de valence numérique.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {ecosystem.map((org) => (
          <a
            href={org.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group p-6 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex justify-between items-start mb-4">
                <span class="label-mono text-[10px]">{org.tag}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-csr-gray-300 group-hover:text-csr-primary transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-csr-black mb-2 group-hover:text-csr-primary transition-colors leading-snug">{org.name}</h3>
              <p class="text-sm text-csr-gray-600 leading-relaxed">{org.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white border border-csr-gray-100 rounded-3xl shadow-card p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <p class="label-mono mb-2">Croissance du Réseau</p>
          <h2 class="text-xl font-bold text-csr-black mb-2">Vous connaissez quelqu'un qui devrait figurer ici ?</h2>
          <p class="text-csr-gray-500 text-sm">Nous cherchons constamment à nous aligner avec des organisations et des chercheurs qui repoussent les limites de la science de la conscience.</p>
        </div>
        <a href="/contact/" class="btn-primary shrink-0 whitespace-nowrap">Suggérer un Ajout</a>
      </div>
    </div>
  </section>

</Layout>
