---
import Layout from '../layouts/Layout.astro';

const institutes = [
  {
    name: "Qualia Research Institute (QRI)",
    description: "A non-profit organization dedicated to mapping the mathematical structure of conscious experience.",
    link: "https://qri.org",
    tag: "Non-Profit"
  },
  {
    name: "Levin Lab",
    description: "Led by Michael Levin at Tufts University, researching bioelectricity, regenerative medicine, and synthetic morphology.",
    link: "https://www.drmichaellevin.org",
    tag: "Research Lab"
  },
  {
    name: "Cronin Group",
    description: "Led by Lee Cronin at the University of Glasgow, exploring the origins of life and Assembly Theory.",
    link: "https://www.chem.gla.ac.uk/cronin/",
    tag: "Research Lab"
  },
  {
    name: "Robin Carhart-Harris",
    description: "Founding Director of the Neuroscape Psychedelics Division at UCSF, focused on the mechanism of action of psychedelics in the brain.",
    link: "https://profiles.ucsf.edu/robin.carhart-harris",
    tag: "Research"
  },
  {
    name: "Sentience Institute",
    description: "An interdisciplinary think tank researching the most effective strategies to expand humanity's moral circle.",
    link: "https://www.sentienceinstitute.org",
    tag: "Think Tank"
  }
];
---

<Layout 
  title="Ecosystem" 
  description="Allied organizations and research institutes working on the physical foundations of awareness and the expansion of our moral circle."
>
  <!-- Header -->
  <section class="py-20 border-b border-csr-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-csr-primary font-mono text-xs uppercase tracking-widest mb-4">Ecosystem</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        The research <span class="text-gradient">network</span>
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed">
        CSR operates within a broader ecosystem of researchers, labs, and non-profits dedicated to understanding the nature of mind and the physical foundations of sentience.
      </p>
    </div>
  </section>

  <!-- Institutes Grid -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {institutes.map((inst) => (
          <a 
            href={inst.link} 
            target="_blank" 
            rel="noopener noreferrer"
            class="group p-8 bg-white border border-gray-100 rounded-3xl hover:border-[#9966CC]/30 hover:shadow-xl hover:shadow-[#9966CC]/5 transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div class="flex justify-between items-start mb-4">
                <span class="text-[10px] font-mono uppercase tracking-wider text-[#9966CC] bg-[#9966CC]/5 px-2 py-1 rounded">
                  {inst.tag}
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-300 group-hover:text-[#9966CC] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <h3 class="text-xl font-bold mb-3 group-hover:text-[#9966CC] transition-colors">{inst.name}</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-6">
                {inst.description}
              </p>
            </div>
            <div class="text-[#9966CC] text-sm font-medium flex items-center gap-1 group-hover:gap-2 transition-all">
              Visit Website
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Collaboration CTA -->
  <section class="py-20 bg-csr-gray-50 border-t border-csr-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold mb-4">Network Growth</h2>
      <p class="text-csr-gray-600 mb-8">We are constantly seeking to align with organizations and researchers pushing the boundaries of consciousness science.</p>
      <a href="/contact" class="inline-block bg-[#9966CC] text-white px-8 py-4 rounded-full font-semibold hover:bg-[#8055ab] transition-all">Suggest an Addition</a>
    </div>
  </section>
</Layout>
