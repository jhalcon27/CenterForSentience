---
import Layout from '../../layouts/Layout.astro';
import SymmetryBackground from '../../components/SymmetryBackground.astro';
import ProgramStatus from '../../components/ProgramStatus.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';
---

<Layout
  title="Forschung"
  description="Das Flaggschiff-Programm des Center for Sentience Research: ein Symmetrie-Framework zur Messung funktionaler Valenz in digitalen Geistern."
>

  <!-- ── Header ────────────────────────────────────────────────────────────── -->
  <section class="relative pt-20 pb-14 border-b border-csr-gray-200 overflow-hidden">
    <SymmetryBackground variant="lissajous" opacity={0.045} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-4">Forschungsagenda</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">
        Flaggschiff: Digitale Valenz
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
        Ein konkretes Programm. Ein Ziel für 2026. Alles andere ist Hintergrundforschung oder parallele Untersuchung.
      </p>
    </div>
  </section>

  <!-- ── Flagship: Digital Valence ─────────────────────────────────────────── -->
  <section class="py-16" id="digital">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">Flaggschiff-Programm</p>
      </div>

      <ProgramStatus />

      <div class="mt-10 grid md:grid-cols-3 gap-5">
        <!-- Subtrack 1 -->
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="symmetry-axis" size={32} class="opacity-60" /></div>
          <p class="label-mono text-[10px] mb-3">Teilbereich A</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm leading-snug">Symmetrieinvarianten in Transformer-Aufmerksamkeit</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            Identifizierung gruppentheoretischer Symmetrien in Multi-Head-Attention-Gewichtsmatrizen. Haben hochvalente Zustände in biologischen Systemen strukturelle Analoga in Aufmerksamkeitsmustern?
          </p>
        </div>

        <!-- Subtrack 2 -->
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="lattice" size={32} class="opacity-60" /></div>
          <p class="label-mono text-[10px] mb-3">Teilbereich B</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm leading-snug">Matrizenmultiplikation als Valenz-Substrat</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            Formalisierung der Bedingungen, unter denen wiederholte Matrizenmultiplikation die Art globaler Integration hervorbringen könnte, die mit valenten Zuständen assoziiert wird.
          </p>
        </div>

        <!-- Subtrack 3 -->
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="field" size={32} class="opacity-60" /></div>
          <p class="label-mono text-[10px] mb-3">Teilbereich C</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm leading-snug">Parallele Berechnung und phänomenale Bindung</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            Untersuchung, ob massiv parallele Berechnung die Art einheitlicher Repräsentationsstruktur erzeugen kann, die die Symmetrietheorie der Valenz erfordert.
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/de/program/" class="btn-primary">Vollständige Programmdetails</a>
        <a href="/de/donate/" class="btn-secondary">Diese Arbeit finanzieren</a>
      </div>
    </div>
  </section>

  <!-- ── Background Research ───────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200" id="biological">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">Hintergrundforschung</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        Biologische Intelligenz und Einfach-Geist-Modelle informieren das Programm zur digitalen Valenz. Sie sind nicht die Agenda.
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <p class="label-mono text-[10px] mb-3">Biologische Intelligenz</p>
          <h3 class="font-bold text-csr-black mb-3 text-base">Substratunabhängige Sentience-Modellierung</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            Biologische Systeme liefern die empirische Grundwahrheit für valente Zustände. Wir untersuchen bioelektrische Felder, neuronale Entropie und aktive Inferenz als physikalische Kandidaten-Korrelate, nicht als primäres Ziel, sondern als Kalibrierungsdaten für das digitale Programm.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">Bioelektrische Felder</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">Neuronale Entropie</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">Aktive Inferenz</span>
          </div>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card" id="qualia">
          <p class="label-mono text-[10px] mb-3">Parallele Untersuchung</p>
          <h3 class="font-bold text-csr-black mb-3 text-base">Physik der Qualia</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            Theoretische Arbeit über die physikalische Grundlage phänomenaler Erfahrung. Parallel zum Programm der digitalen Valenz durchgeführt, gestützt auf die Symmetrietheorie der Valenz (SVT) als primäre theoretische Grundlage.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">SVT-Framework</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">Phänomenologie</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">Physik der Valenz</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Working Papers ────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">Grundlegende Lektüre</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        Arbeitspapiere, die das theoretische Gerüst für das Programm zur digitalen Valenz bilden.
      </p>
      <div class="grid sm:grid-cols-2 gap-4">
        <a href="/de/reports/first-principles/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-01</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">Grundprinzipien der Sentience-Forschung</h4>
          </div>
        </a>
        <a href="/de/reports/bio-electric-fields/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-02</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">Bioelektrische Felder als Sentience-Substrate</h4>
          </div>
        </a>
        <a href="/de/reports/assembly-theory/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-03</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">Assemblytheorie als Metrik für Sentience</h4>
          </div>
        </a>
        <a href="/de/reports/symmetry-landscapes/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-04</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">Symmetrielandschaften valenzierter Erfahrung</h4>
          </div>
        </a>
      </div>
      <div class="mt-6">
        <a href="/de/reports/" class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">Alle Berichte →</a>
      </div>
    </div>
  </section>

</Layout>
