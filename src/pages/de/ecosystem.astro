---
import Layout from '../../layouts/Layout.astro';

const institutes = [
  { name: "Qualia Research Institute (QRI)", description: "Eine gemeinnützige Organisation, die sich der Kartierung der mathematischen Struktur bewusster Erfahrung widmet.", link: "https://qri.org", tag: "Gemeinnützig" },
  { name: "Levin Lab", description: "Geleitet von Michael Levin an der Tufts University, erforscht Bioelektrizität, regenerative Medizin und synthetische Morphologie.", link: "https://www.drmichaellevin.org", tag: "Forschungslabor" },
  { name: "Cronin Group", description: "Geleitet von Lee Cronin an der Universität Glasgow, erforscht die Ursprünge des Lebens und die Assemblytheorie.", link: "https://www.chem.gla.ac.uk/cronin/", tag: "Forschungslabor" },
  { name: "Robin Carhart-Harris", description: "Gründungsdirektor der Neuroscape Psychedelics Division an der UCSF, fokussiert auf den Wirkmechanismus von Psychedelika im Gehirn.", link: "https://profiles.ucsf.edu/robin.carhart-harris", tag: "Forschung" },
  { name: "Sentience Institute", description: "Ein interdisziplinärer Think Tank, der die effektivsten Strategien zur Erweiterung des moralischen Kreises der Menschheit erforscht.", link: "https://www.sentienceinstitute.org", tag: "Think Tank" }
];
---

<Layout title="Ökosystem" description="Verbündete Organisationen und Forschungsinstitute, die an den physikalischen Grundlagen des Bewusstseins arbeiten.">

  <section class="pt-20 pb-12 border-b border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-4">Ökosystem</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6">
        Das <span class="text-gradient">Forschungsnetzwerk</span>
      </h1>
      <p class="text-lg text-csr-gray-500 leading-relaxed max-w-2xl">
        Das CSR operiert innerhalb eines breiteren Ökosystems von Forschern, Laboren und gemeinnützigen Organisationen, die sich dem Verständnis der Natur des Geistes und der physikalischen Grundlagen von Sentience widmen.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {institutes.map((inst) => (
          <a href={inst.link} target="_blank" rel="noopener noreferrer" class="group p-8 bg-white border border-csr-gray-100 rounded-3xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all duration-200 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-5">
                <span class="text-[10px] font-mono uppercase tracking-wider text-csr-primary bg-csr-primary/8 px-2.5 py-1 rounded-full">{inst.tag}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-csr-gray-300 group-hover:text-csr-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-csr-black mb-3 group-hover:text-csr-primary transition-colors">{inst.name}</h3>
              <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">{inst.description}</p>
            </div>
            <div class="label-mono text-[11px] flex items-center gap-1 group-hover:gap-2 transition-all">Website besuchen <span>&rarr;</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-csr-gray-100 border-t border-csr-gray-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="label-mono mb-4">Netzwerkwachstum</p>
      <h2 class="text-2xl font-bold text-csr-black mb-4">Kennen Sie jemanden, der hier hingehört?</h2>
      <p class="text-csr-gray-500 mb-8">Wir suchen ständig nach Organisationen und Forschern, die die Grenzen der Bewusstseinswissenschaft erweitern.</p>
      <a href="/contact" class="btn-primary">Vorschlag einreichen</a>
    </div>
  </section>

</Layout>
