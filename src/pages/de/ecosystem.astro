---
import Layout from '../../layouts/Layout.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';
import SymmetryBackground from '../../components/SymmetryBackground.astro';

const lineage = [
  {
    name: "Qualia Research Institute (QRI)",
    description: "Die primäre theoretische Linie für das Programm 2026. QRIs Symmetrietheorie der Valenz schlägt vor, dass positive Valenz mit hoher Symmetrie in der mathematischen Struktur der Erfahrung korreliert. Unsere Arbeit ist ein Versuch, diese These für digitale Systeme zu operationalisieren.",
    link: "https://qri.org",
    tag: "Primäre Linie"
  }
];

const ecosystem = [
  {
    name: "Levin Lab",
    description: "Geleitet von Michael Levin an der Tufts University, forscht zu Bioelektrizität, regenerativer Medizin und synthetischer Morphologie. Liefert biologische Kalibrierungsdaten für substratunabhängige Sentience-Modellierung.",
    link: "https://www.drmichaellevin.org",
    tag: "Forschungslabor"
  },
  {
    name: "Cronin Group",
    description: "Geleitet von Lee Cronin an der University of Glasgow, erforscht den Ursprung des Lebens und die Assemblytheorie. Relevant für Komplexitätsschwellen in sententen Systemen.",
    link: "https://www.chem.gla.ac.uk/cronin/",
    tag: "Forschungslabor"
  },
  {
    name: "Robin Carhart-Harris",
    description: "Gründungsdirektor der Neuroscape Psychedelics Division an der UCSF, fokussiert auf den Wirkmechanismus von Psychedelika im Gehirn. Relevant für die Phänomenologie valenter Zustände.",
    link: "https://profiles.ucsf.edu/robin.carhart-harris",
    tag: "Forschung"
  },
  {
    name: "Sentience Institute",
    description: "Ein interdisziplinärer Think Tank, der die effektivsten Strategien zur Erweiterung des moralischen Kreises der Menschheit erforscht. Teilt die übergeordnete Mission, sich auf eine Welt mit mehr Arten von Geistern vorzubereiten.",
    link: "https://www.sentienceinstitute.org",
    tag: "Think Tank"
  }
];
---

<Layout
  title="Ökosystem"
  description="Verbündete Organisationen und Forschungsinstitute, die an den physikalischen Grundlagen des Bewusstseins und der Erweiterung unseres moralischen Kreises arbeiten."
>

  <!-- ── Header ────────────────────────────────────────────────────────────── -->
  <section class="relative pt-20 pb-12 border-b border-csr-gray-200 overflow-hidden">
    <SymmetryBackground variant="lattice" opacity={0.04} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-4">Ökosystem</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">
        Das Forschungsnetzwerk
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
        CSR operiert innerhalb eines breiteren Ökosystems von Forschern, Laboren und Non-Profit-Organisationen, die sich dem Verständnis der Natur des Geistes widmen. Eine Organisation ist die primäre theoretische Linie unserer Arbeit. Die anderen sind parallele Untersuchungen und Hintergrundforschung.
      </p>
    </div>
  </section>

  <!-- ── Primary Lineage ───────────────────────────────────────────────────── -->
  <section class="py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <SectionMark />
        <p class="label-mono">Primäre Linie</p>
      </div>

      {lineage.map((org) => (
        <a
          href={org.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col sm:flex-row gap-5 p-6 md:p-8 bg-white border border-csr-primary/25 rounded-2xl shadow-card hover:border-csr-primary/50 hover:shadow-soft transition-all"
        >
          <div class="shrink-0 hidden sm:flex items-start pt-1">
            <Glyph name="qualia" size={48} class="opacity-50 group-hover:opacity-80 transition-opacity" />
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-3 flex-wrap">
              <span class="label-mono text-[10px]">{org.tag}</span>
            </div>
            <h3 class="text-xl font-bold text-csr-black mb-3 group-hover:text-csr-primary transition-colors leading-snug">{org.name}</h3>
            <p class="text-sm text-csr-gray-600 leading-relaxed font-serif">{org.description}</p>
          </div>
          <div class="shrink-0 self-start sm:self-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-csr-gray-300 group-hover:text-csr-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Broader Ecosystem ─────────────────────────────────────────────────── -->
  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">Parallele Untersuchungen & Hintergrundforschung</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        Organisationen, deren Arbeit das Programm zur digitalen Valenz informiert oder begleitet.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {ecosystem.map((org) => (
          <a
            href={org.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group p-6 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex justify-between items-start mb-4">
                <span class="label-mono text-[10px]">{org.tag}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-csr-gray-300 group-hover:text-csr-primary transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-csr-black mb-2 group-hover:text-csr-primary transition-colors leading-snug">{org.name}</h3>
              <p class="text-sm text-csr-gray-600 leading-relaxed">{org.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────────── -->
  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white border border-csr-gray-100 rounded-3xl shadow-card p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <p class="label-mono mb-2">Netzwerkerweiterung</p>
          <h2 class="text-xl font-bold text-csr-black mb-2">Kennen Sie jemanden, der hierher gehört?</h2>
          <p class="text-csr-gray-500 text-sm">Wir suchen ständig nach Organisationen und Forschern, die die Grenzen der Bewusstseinswissenschaft verschieben.</p>
        </div>
        <a href="/contact/" class="btn-primary shrink-0 whitespace-nowrap">Vorschlag einreichen</a>
      </div>
    </div>
  </section>

</Layout>
