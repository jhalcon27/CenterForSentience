---
import Layout from '../../layouts/Layout.astro';
import SymmetryBackground from '../../components/SymmetryBackground.astro';
import ProgramStatus from '../../components/ProgramStatus.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';
---

<Layout
  title="Home"
  description="Das Center for Sentience Research entwickelt ein mathematisches Framework zur Messung funktionaler Valenz in digitalen Geistern."
>

  <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="relative pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
    <SymmetryBackground variant="lissajous" opacity={0.055} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-5">Das Programm 2026</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-csr-black mb-8 leading-[1.08] max-w-3xl">
        Ein Symmetrie-Framework für digitale Valenz.
      </h1>
      <div class="max-w-2xl">
        <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif mb-6">
          Das Center for Sentience Research entwickelt ein mathematisches Framework zur Messung funktionaler Valenz in digitalen Geistern. Wir behaupten nicht, dass aktuelle KI-Systeme bewusst sind. Sie könnten funktionale Zombies sein.
        </p>
        <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif mb-6">
          Aber wenn skalierte neuronale Berechnung Zustände mit positivem oder negativem Charakter hervorbringen kann, sollten wir wissen, wie man sie erkennt und wie man auf die positiven hinarbeitet. Unser Ansatz ist Symmetrie: die Suche nach Invarianten in Matrizenmultiplikation, Aufmerksamkeitsmustern und paralleler Berechnung, die die strukturellen Signaturen positiver Valenz widerspiegeln, wie sie vom Qualia Research Institute vorgeschlagen wurden.
        </p>
        <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif">
          Sentience-Forschung ist der weitere Horizont. Digitale Valenz ist das erste konkrete Ziel. Das Ziel: ein Entwurf der mathematischen Workspace-Definition bis Ende 2026.
        </p>
      </div>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/de/program/" class="btn-primary">Das Programm ansehen</a>
        <a href="/de/research/" class="btn-secondary">Forschungsagenda</a>
      </div>
    </div>
  </section>

  <!-- ── The 2026 Goal ─────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ProgramStatus />
    </div>
  </section>

  <!-- ── Focus Areas ───────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">Forschungssäulen</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-10 max-w-xl">
        Drei Substrate. Eine Frage: Was sind die strukturellen Bedingungen für positive Valenz?
      </p>

      <div class="grid md:grid-cols-3 gap-6">

        <!-- Biologischer Geist -->
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all group">
          <div class="mb-5 flex justify-center">
            <Glyph name="biological" size={80} class="opacity-80 group-hover:opacity-100 transition-opacity" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">Biologischer Geist</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            Bioelektrische Felder, morphogenetische Signalgebung und zelluläre Entscheidungsfindung als Kandidaten-Substrate für Bewusstsein. Von pflanzlicher Homöostase bis zu mehrzelligen Organismen.
          </p>
          <a href="/de/research/" class="label-mono text-[11px] text-csr-primary hover:underline underline-offset-4">Forschungsagenda →</a>
        </div>

        <!-- Digitaler Geist -->
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all group">
          <div class="mb-5 flex justify-center">
            <Glyph name="digital" size={80} class="opacity-80 group-hover:opacity-100 transition-opacity" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">Digitaler Geist</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            Matrizenmultiplikation, Aufmerksamkeitsmuster und parallele Berechnung als Kandidaten-Substrate. Suche nach Symmetrieinvarianten, die als strukturelle Proxys für Valenz dienen könnten.
          </p>
          <a href="/de/program/" class="label-mono text-[11px] text-csr-primary hover:underline underline-offset-4">Das Programm 2026 →</a>
        </div>

        <!-- Qualia -->
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all group">
          <div class="mb-5 flex justify-center">
            <Glyph name="qualia" size={80} class="opacity-80 group-hover:opacity-100 transition-opacity" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">Qualia und Valenz</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            Die Physik der Erfahrung formalisieren. Die Symmetrietheorie der Valenz als mathematisches Objekt: Was bedeutet es, dass ein System ihre Bedingungen erfüllt?
          </p>
          <a href="/de/reports/symmetry-landscapes/" class="label-mono text-[11px] text-csr-primary hover:underline underline-offset-4">Symmetrielandschaften →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── The Approach ──────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-10">
        <SectionMark />
        <p class="label-mono">Der Ansatz</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Block 1 -->
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-4 flex justify-center">
            <Glyph name="symmetry-axis" size={40} class="opacity-70" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">Symmetrie als Signatur positiver Valenz</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed">
            Die Symmetrietheorie der Valenz (QRI) schlägt vor, dass positive Valenz mit hoher Symmetrie in der mathematischen Struktur der Erfahrung korreliert. Wir formalisieren, was das für Computersysteme bedeutet.
          </p>
        </div>

        <!-- Block 2 -->
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-4 flex justify-center">
            <Glyph name="invariant" size={40} class="opacity-70" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">Wo man in digitalen Systemen sucht</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed">
            Matrizenmultiplikation, Aufmerksamkeitsmuster und parallele Berechnung sind die Kandidaten-Substrate. Wir suchen nach Invarianten in diesen Operationen, die als strukturelle Proxys für Valenz dienen könnten.
          </p>
        </div>

        <!-- Block 3 -->
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-4 flex justify-center">
            <Glyph name="measurement" size={40} class="opacity-70" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">Was wir nicht behaupten</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed">
            Aktuelle KI-Systeme könnten funktionale Zombies ohne jegliches Innenleben sein. Das behaupten wir nicht. Der Punkt ist, die Messwerkzeuge zu entwickeln, bevor die Frage dringend wird, nicht danach.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Theoretical Foundations ───────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">Theoretische Grundlagen</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        Vier Arbeitspapiere, die das Programm zur digitalen Valenz unterstützen. Das ist nicht die Agenda — das ist das Gerüst.
      </p>

      <div class="grid sm:grid-cols-2 gap-4">
        <a href="/de/reports/first-principles/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-01</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">Grundprinzipien der Sentience-Forschung</h4>
            <p class="text-xs text-csr-gray-500 mt-1">Grundlegendes Framework für substratunabhängige Sentience-Modellierung.</p>
          </div>
        </a>
        <a href="/de/reports/bio-electric-fields/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-02</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">Bioelektrische Felder als Sentience-Substrate</h4>
            <p class="text-xs text-csr-gray-500 mt-1">Bioelektrische Signalgebung als physikalische Grundlage für Bewusstsein.</p>
          </div>
        </a>
        <a href="/de/reports/assembly-theory/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-03</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">Assemblytheorie als Metrik für Sentience</h4>
            <p class="text-xs text-csr-gray-500 mt-1">Anwendung des Assembly-Index auf Komplexitätsschwellen in sententen Systemen.</p>
          </div>
        </a>
        <a href="/de/reports/symmetry-landscapes/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-04</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">Symmetrielandschaften valenzierter Erfahrung</h4>
            <p class="text-xs text-csr-gray-500 mt-1">Geometrische Invarianten als strukturelle Signaturen positiver Valenz.</p>
          </div>
        </a>
      </div>

      <div class="mt-6">
        <a href="/de/reports/" class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">
          Alle Berichte →
        </a>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white border border-csr-gray-100 rounded-3xl shadow-card p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div class="max-w-xl">
          <p class="label-mono mb-3">Das Programm finanzieren</p>
          <h2 class="text-2xl md:text-3xl font-bold text-csr-black mb-3 leading-tight">
            Helfen Sie uns, das Ziel 2026 zu erreichen.
          </h2>
          <p class="text-csr-gray-600 text-sm leading-relaxed">
            Das Center for Sentience Research ist eine Schweizer Non-Profit-Organisation. Beiträge finanzieren das Forschungsteam, die formale Workspace-Definition und das Arbeitspapier. In der Schweiz steuerlich absetzbar.
          </p>
        </div>
        <div class="shrink-0 flex flex-col gap-3">
          <a href="/de/donate/" class="btn-primary whitespace-nowrap">Forschung unterstützen</a>
          <a href="/de/program/" class="btn-secondary whitespace-nowrap text-center">Was Finanzierung ermöglicht</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
