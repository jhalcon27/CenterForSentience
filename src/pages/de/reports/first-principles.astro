---
import Layout from '../../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="Erste Prinzipien der Empfindungsforschung" description="Grundlagenpapier zur Modellierung des Bewusstseins auf allen Substraten.">
  <article class="py-12 max-w-4xl mx-auto px-4">
    <p class="text-[#9966CC] font-mono text-xs uppercase tracking-widest mb-4">Grundlagenpapier — CSR-WP-01</p>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">Erste Prinzipien der Empfindungsforschung</h1>
    <div class="prose prose-slate">
      <p><em>In Arbeit.</em></p>
    </div>
  </article>
</Layout>
