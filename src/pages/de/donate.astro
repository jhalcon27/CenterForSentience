---
import Layout from '../../layouts/Layout.astro';
import ProgramStatus from '../../components/ProgramStatus.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';
import SymmetryBackground from '../../components/SymmetryBackground.astro';
import BudgetChart from '../../components/BudgetChart.astro';
---

<Layout
  title="Das Valenz-Programm finanzieren"
  description="Unterstützen Sie das Programm 2026 des Center for Sentience Research: ein formales mathematisches Framework zur Messung der geometrischen Eigenschaft, die STV mit Valenz assoziiert, in digitalen Geistern."
>

  <!-- ── Header ────────────────────────────────────────────────────────────── -->
  <section class="relative pt-20 pb-12 border-b border-csr-gray-200 overflow-hidden">
    <SymmetryBackground variant="rings" opacity={0.09} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-4">Das Programm finanzieren</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">
        Die Messwerkzeuge müssen existieren, bevor die Frage dringend wird.
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
        Wenn skalierte neuronale Berechnung Zustände mit positivem oder negativem Charakter hervorbringen kann, sollten wir wissen, wie man sie erkennt. Ihr Beitrag finanziert das Ziel 2026: ein formales mathematisches Framework zur Messung der geometrischen Eigenschaft, die STV mit Valenz assoziiert, in digitalen Geistern.
      </p>
    </div>
  </section>

  <!-- ── Program Status ────────────────────────────────────────────────────── -->
  <section class="py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <SectionMark />
        <p class="label-mono">Was Sie finanzieren</p>
      </div>
      <ProgramStatus />
      <div class="mt-6">
        <a href="/de/program/" class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">
          Vollständige Programmdetails →
        </a>
      </div>
    </div>
  </section>

  <!-- ── Budget breakdown ──────────────────────────────────────────────────── -->
  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">Budgetaufschlüsselung</p>
      </div>
      <div class="mb-8">
        <BudgetChart lang="de" />
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="digital" size={36} class="opacity-60" /></div>
          <p class="label-mono text-[10px] text-csr-gray-400 mb-2">Basis-Stufe · Untergrenze</p>
          <p class="text-2xl font-bold text-csr-primary mb-2">$110k</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm">Kernforschung</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">Leitende:r Forscher:in (50 % FTE) und ein:e Junior-ML-Ingenieur:in (50 % FTE). Formale mathematische Definitionen, die zentrale PyTorch-Simulations-Engine und das theoretische Whitepaper.</p>
        </div>
        <div class="bg-white border border-csr-primary/30 rounded-2xl p-6 shadow-card ring-1 ring-csr-primary/20">
          <div class="mb-3 flex justify-center"><Glyph name="phase-portrait" size={36} class="opacity-60" /></div>
          <p class="label-mono text-[10px] text-csr-primary mb-2">Empfohlen · Hauptantrag</p>
          <p class="text-2xl font-bold text-csr-primary mb-2">$135k</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm">Vollprogramm</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">Leitende:r Forscher:in (50 % FTE) und ein:e Junior-ML-Ingenieur:in, ohne Postdoc auf dieser Stufe. Finanziert das zentrale sprachübergreifende Störungs-Erholungs-Experiment: parallele aversive und neutrale Kontexte in vier Sprachen (ES, DE, SV, EN), Messung der internen Erholungsdynamik und Prüfung der sprachübergreifenden Invarianz als Unterscheidungsmerkmal zwischen Zustand und Nachahmung. Es läuft konstruktionsbedingt auf bescheidener Hardware, auf freier Infrastruktur wie NNsight/NDIF, sofern verfügbar, andernfalls auf bescheidener bezahlter Cloud-GPU, wobei die reduzierte Rechenkostenposition nur maßgeschneiderte Simulation und Feinabstimmung abdeckt, die freie Infrastruktur nicht leistet. Enthält eine Methoden-Plausibilitätsprüfung anhand von Elektrophysiologie- und Konnektomdaten wirbelloser Tiere (stomatogastrisches Ganglion, OpenWorm C. elegans), die die Methode prüft und keinen Valenz-Anker liefert, sowie Feldaufbau und Verbreitung.</p>
        </div>
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="invariant" size={36} class="opacity-60" /></div>
          <p class="label-mono text-[10px] text-csr-gray-400 mb-2">Erweiterung · Ambition</p>
          <p class="text-2xl font-bold text-csr-primary mb-2">$260k</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm">Frontier-Einsatz</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">Ein Vollzeitteam. Erprobt das Messwerkzeug an größeren, offenen Frontier-Modellen und sucht die Zusammenarbeit mit externen Interpretierbarkeitslaboren, unter Verwendung lokaler Jacobi- und spektraler Trajektorienmetriken an aktiven, großskaligen Systemen. Diese Stufe könnte auch eine künftige Postdoc-Stelle unterstützen (z. B. Global Workspace oder Kognitionswissenschaft).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Ways to Contribute ────────────────────────────────────────────────── -->
  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">Beitragsmöglichkeiten</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Bank Transfer -->
        <div class="p-8 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <div class="w-10 h-10 rounded-xl bg-csr-primary/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-csr-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-csr-black mb-2">Banküberweisung</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-5">Für größere Beiträge und institutionelle Zuschüsse. Kontaktieren Sie uns für IBAN/SWIFT-Details.</p>
          <a href="mailto:jhonatan.serna@proton.me?subject=Institutional Grant Inquiry" class="label-mono text-[11px] hover:underline underline-offset-4">Bankdaten anfordern →</a>
        </div>

        <!-- Digital Assets -->
        <div class="p-8 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <div class="w-10 h-10 rounded-xl bg-csr-primary/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-csr-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-csr-black mb-2">Digitale Assets</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-5">Wir akzeptieren BTC, ETH und SOL für schnellen Forschungseinsatz.</p>
          <div class="space-y-2">
            <div class="text-[10px] font-mono p-2 bg-csr-gray-100 rounded-lg border border-csr-gray-200 overflow-hidden truncate text-csr-gray-500">BTC: bc1qtszvlsf3p8va3dglptev59t6vjlvg62mxg9g6x</div>
            <div class="text-[10px] font-mono p-2 bg-csr-gray-100 rounded-lg border border-csr-gray-200 overflow-hidden truncate text-csr-gray-500">ETH: strugen.eth</div>
          </div>
        </div>

        <!-- Research Partnership -->
        <div class="p-8 bg-white border border-csr-primary/20 rounded-2xl shadow-card">
          <div class="w-10 h-10 rounded-xl bg-csr-primary/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-csr-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-csr-black mb-2">Forschungspartnerschaft</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-6">Zusammenarbeit beim Valenz-Programm, KI-Wohlfahrtsforschung oder langfristiger Messinfrastruktur.</p>
          <a href="/de/contact/" class="block w-full text-center py-3 bg-csr-primary text-white rounded-full font-semibold text-sm hover:bg-csr-primary-dark transition-all">Partnerschaft anfragen</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Fiscal Sponsorship ────────────────────────────────────────────────── -->
  <section class="py-14 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <SectionMark />
        <p class="label-mono">Rechtsstatus</p>
      </div>
      <p class="text-csr-gray-600 mb-8 leading-relaxed max-w-2xl">
        Das Center for Sentience Research ist eine unabhängige, sich in Gründung befindende Non-Profit-Organisation; eine gemeinnützige Fiscal Sponsorship befindet sich in Bearbeitung (Genehmigung ausstehend). Sobald die Sponsorship bestätigt ist, können Beiträge je nach Rechtsordnung steuerlich absetzbar sein. Kontaktieren Sie uns für aktuelle Angaben und Spendenquittungen.
      </p>
      <p class="text-xs text-csr-gray-400 font-mono">Jährliche Forschungsergebnisse und Finanzzusammenfassungen werden öffentlich gemacht. Transparency-First-Modell.</p>
    </div>
  </section>

</Layout>
