---
import Layout from '../../layouts/Layout.astro';
import SymmetryBackground from '../../components/SymmetryBackground.astro';
import SectionMark from '../../components/SectionMark.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const reproductions = await getCollection('reproductions', ({ data }: CollectionEntry<'reproductions'>) => !data.draft);
const sorted = reproductions.sort((a: CollectionEntry<'reproductions'>, b: CollectionEntry<'reproductions'>) => b.data.updated.getTime() - a.data.updated.getTime());

const statusLabels: Record<string, { label: string; class: string }> = {
  'in-progress': { label: 'In progress', class: 'bg-amber-100 text-amber-800 border-amber-200' },
  'done': { label: 'Done', class: 'bg-emerald-100 text-emerald-800 border-emerald-200' },
  'abandoned': { label: 'Abandoned', class: 'bg-csr-gray-100 text-csr-gray-600 border-csr-gray-200' },
};
---

<Layout
  title="Reproductions"
  description="Independent reproductions of published mechanistic interpretability results, working toward measuring internal model states."
>
  <section class="relative pt-20 pb-14 border-b border-csr-gray-200 overflow-hidden">
    <SymmetryBackground variant="rings" opacity={0.08} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4">
        <SectionMark />
        <p class="label-mono">Mechanistic Interpretability</p>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">
        Reproductions
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
        Publishing independent reproductions of key mechanistic interpretability results. We work on one reproduction at a time, documenting experimental setups, discrepancies, and implications for internal state measurement.
      </p>
      <div class="mt-6 flex items-center gap-4 text-xs font-mono">
        <a href="/reproductions/rss.xml" class="text-csr-primary hover:underline flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93v-2.83Z"/>
          </svg>
          RSS Feed
        </a>
        <span class="text-csr-gray-300">·</span>
        <a href="/research/" class="text-csr-gray-500 hover:text-csr-black">Long-term research agenda →</a>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {sorted.length === 0 ? (
        <div class="glass-card rounded-2xl p-8 md:p-12 border border-csr-gray-200 text-center max-w-2xl mx-auto">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-medium bg-amber-50 text-amber-800 border border-amber-200 mb-4">
            First write-up in progress
          </span>
          <h2 class="text-2xl font-bold text-csr-black mb-3">
            Active Reproduction: Induction Heads
          </h2>
          <p class="text-csr-gray-600 font-serif leading-relaxed mb-6 text-base">
            Jhonatan Serna writes one reproduction at a time on a weekly cadence. The first reproduction currently underway examines induction heads and circuit formation in transformer language models (Olsson et al., 2022).
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 text-sm">
            <a href="/reproductions/rss.xml" class="btn-primary w-full sm:w-auto">
              Subscribe to RSS
            </a>
            <a href="/research/" class="btn-secondary w-full sm:w-auto">
              Read Research Agenda
            </a>
          </div>
        </div>
      ) : (
        <div class="space-y-6">
          {sorted.map((item) => {
            const st = statusLabels[item.data.status] ?? statusLabels['in-progress'];
            return (
              <article class="glass-card rounded-2xl p-6 md:p-8 border border-csr-gray-200 hover:border-csr-primary/30 transition-all">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                  <span class={`px-2.5 py-0.5 rounded-full text-xs font-mono font-medium border ${st.class}`}>
                    {st.label}
                  </span>
                  <time class="text-xs font-mono text-csr-gray-400">
                    Updated {item.data.updated.toISOString().slice(0, 10)}
                  </time>
                </div>
                <h2 class="text-2xl font-bold text-csr-black mb-2">
                  <a href={`/reproductions/${item.slug}/`} class="hover:text-csr-primary transition-colors">
                    {item.data.title}
                  </a>
                </h2>
                <p class="text-sm text-csr-gray-500 font-mono mb-4">
                  Target: <a href={item.data.paper.url} target="_blank" rel="noopener noreferrer" class="text-csr-primary hover:underline">{item.data.paper.title}</a> ({item.data.paper.authors.split(',')[0]} et al., {item.data.paper.year})
                </p>
                <p class="text-base text-csr-gray-700 font-serif leading-relaxed mb-6">
                  <strong class="font-sans font-semibold text-csr-black">Claim:</strong> {item.data.claim}
                </p>
                <div class="flex items-center justify-between pt-4 border-t border-csr-gray-100 text-sm">
                  <span class="text-xs font-mono text-csr-gray-500">
                    Model: {item.data.setup.model}
                  </span>
                  <a href={`/reproductions/${item.slug}/`} class="text-csr-primary font-semibold hover:underline flex items-center gap-1">
                    Read write-up →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Layout>
