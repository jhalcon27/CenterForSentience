---
import Layout from '../layouts/Layout.astro';

const articles = [
  {
    slug: 'first-principles',
    title: 'First Principles of Sentience Research',
    subtitle: '(WIP)',
    excerpt: 'The foundational framework for modeling awareness across all substrates.',
    date: '2026-04-17',
    readTime: 'In Progress',
    tags: ['Foundational', 'Physics'],
  },
  {
    slug: 'bio-electric-fields',
    title: 'Bio-Electric Fields as Sentience Substrates',
    subtitle: '(WIP)',
    excerpt: 'Exploring morphological intelligence and cellular decision-making.',
    date: '2026-04-17',
    readTime: 'In Progress',
    tags: ['Biology', 'Intelligence'],
  },
  {
    slug: 'assembly-theory',
    title: 'Assembly Theory as a Metric for Sentience',
    subtitle: '(WIP)',
    excerpt: 'Quantifying sentience through the assembly of physical information.',
    date: '2026-04-17',
    readTime: 'In Progress',
    tags: ['Physics', 'Information'],
  },
  {
    slug: 'symmetry-landscapes',
    title: 'Symmetry Landscapes of Valenced Experience',
    subtitle: '(WIP)',
    excerpt: 'Mapping the neural energy landscapes of experience.',
    date: '2026-04-17',
    readTime: 'In Progress',
    tags: ['Neuroscience', 'Qualia'],
  },
];
---

<Layout title="Mapping the Architecture of Awareness">
  <!-- Hero Section -->
  <section class="py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(153,102,204,0.05),transparent_50%)]"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        Measuring and quantifying <br/>
        <span class="text-gradient">sentience</span>
      </h1>
      <p class="text-lg text-csr-gray-600 max-w-2xl mx-auto leading-relaxed mb-8">
        The Center for Sentience Research (CSR) is an independent Swiss non-profit building the foundational framework for measuring awareness across substrates. Bridging physics, neuroscience, and philosophy, we investigate three domains: biological minds (morphological intelligence and cellular decision-making), digital minds (whether and how sentience could emerge in non-biological systems), and qualia (the physical structure of experience and valence). This work is urgent. As AI systems increasingly present as sentient and as science reveals awareness-like properties in unexpected biological substrates, society needs rigorous, substrate-independent methods to evaluate such claims. Without scientific foundations, these questions will be decided by intuition, commercial interest, or ideology. CSR exists to provide the measurement frameworks before that happens.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/research" class="btn-primary px-6 py-3 bg-csr-primary text-white rounded-full font-semibold hover:bg-csr-primary-dark transition-all shadow-lg shadow-csr-primary/20">Research Agenda</a>
        <a href="#outputs" class="px-6 py-3 border border-csr-gray-200 rounded-full font-semibold hover:bg-csr-gray-50 transition-all">White Papers</a>
      </div>
    </div>
  </section>

  <!-- Focus Areas -->
  <section class="py-12 border-t border-csr-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-16">
        <h2 class="text-xs font-mono uppercase tracking-[0.3em] text-csr-primary mb-4">The Ingredients</h2>
        <p class="text-3xl font-bold">Researching the substrates of experience</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 border border-csr-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">Biological Mind</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">Investigating morphological intelligence, cellular decision-making, and awareness in biological systems.</p>
          <a href="/research#biological" class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">Learn More &rarr;</a>
        </div>
        <div class="p-8 border border-csr-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">Digital Mind</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">Evaluating if sentience could emerge in non-biological substrates and how to measure it.</p>
          <a href="/research#digital" class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">Learn More &rarr;</a>
        </div>
        <div class="p-8 border border-csr-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">Qualia</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">Formalizing the physics of experience, mapping neural entropy, and defining the structure of valence.</p>
          <a href="/research#qualia" class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">Learn More &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Outputs -->
  <section id="outputs" class="py-12 bg-csr-black text-white overflow-hidden relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
       <h2 class="text-xs font-mono uppercase tracking-[0.3em] text-csr-primary mb-12">Working Research Papers (WIP)</h2>
       <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
         {articles.map(art => (
           <a href={`/reports/${art.slug}`} class="block p-6 border border-white/10 rounded-xl hover:border-csr-primary transition-all bg-white/5">
             <h4 class="text-lg font-bold mb-2">{art.title}</h4>
             <p class="text-gray-400 text-xs">{art.subtitle}</p>
           </a>
         ))}
       </div>
    </div>
  </section>
</Layout>
