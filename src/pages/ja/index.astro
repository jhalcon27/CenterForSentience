---
import Layout from '../../layouts/Layout.astro';
import SymmetryBackground from '../../components/SymmetryBackground.astro';
import ProgramStatus from '../../components/ProgramStatus.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';
---

<Layout
  title="ホーム"
  description="感覚研究センターは、デジタルマインドにおける機能的感情価を測定するための数学的フレームワークを構築しています。"
>

  <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="relative pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
    <SymmetryBackground variant="lissajous" opacity={0.055} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-5">2026年プログラム</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-csr-black mb-8 leading-[1.08] max-w-3xl">
        デジタル感情価のための対称性フレームワーク。
      </h1>
      <div class="max-w-2xl">
        <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif mb-6">
          感覚研究センターは、デジタルマインドにおける機能的感情価を測定するための数学的フレームワークを構築しています。現在のAIシステムが意識を持つとは主張しません。それらは機能的ゾンビかもしれません。
        </p>
        <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif mb-6">
          しかし、大規模なニューラル計算が正または負の性質を持つ状態を生み出せるなら、それらを認識する方法と、正の状態のために設計する方法を知るべきです。私たちのアプローチは対称性です：行列乗算、注意パターン、並列計算における不変量を探し、Qualia研究所が提案する正の感情価の構造的特徴を反映させます。
        </p>
        <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif">
          感覚研究はより広い地平線です。デジタルマインドの感情価が最初の具体的な目標です。目標：2026年末までにワークスペースの数学的定義の草案を完成させること。
        </p>
      </div>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/ja/program/" class="btn-primary">プログラムを見る</a>
        <a href="/ja/research/" class="btn-secondary">研究アジェンダ</a>
      </div>
    </div>
  </section>

  <!-- ── The 2026 Goal ─────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ProgramStatus />
    </div>
  </section>

  <!-- ── Focus Areas ───────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">研究の柱</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-10 max-w-xl">
        三つの基盤。一つの問い：正の感情価の構造的条件とは何か？
      </p>

      <div class="grid md:grid-cols-3 gap-6">

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all group">
          <div class="mb-5 flex justify-center">
            <Glyph name="biological" size={80} class="opacity-80 group-hover:opacity-100 transition-opacity" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">生物学的マインド</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            生体電場、形態形成シグナル伝達、細胞の意思決定が意識の候補基盤として。植物の恒常性から多細胞生物まで。
          </p>
          <a href="/ja/research/" class="label-mono text-[11px] text-csr-primary hover:underline underline-offset-4">研究アジェンダ →</a>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all group">
          <div class="mb-5 flex justify-center">
            <Glyph name="digital" size={80} class="opacity-80 group-hover:opacity-100 transition-opacity" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">デジタルマインド</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            行列乗算、注意パターン、並列計算が候補基盤として。感情価の構造的プロキシとして機能できる対称性不変量を探します。
          </p>
          <a href="/ja/program/" class="label-mono text-[11px] text-csr-primary hover:underline underline-offset-4">2026年プログラム →</a>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all group">
          <div class="mb-5 flex justify-center">
            <Glyph name="qualia" size={80} class="opacity-80 group-hover:opacity-100 transition-opacity" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">クオリアと感情価</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            経験の物理学を形式化する。数学的対象としての感情価対称性理論：システムがその条件を満たすとはどういう意味か？
          </p>
          <a href="/ja/reports/symmetry-landscapes/" class="label-mono text-[11px] text-csr-primary hover:underline underline-offset-4">対称性の景観 →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── The Approach ──────────────────────────────────────────────────────── -->
  <section class="relative py-16 border-t border-csr-gray-200 overflow-hidden">
    <SymmetryBackground variant="wave" opacity={0.05} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-10">
        <SectionMark />
        <p class="label-mono">アプローチ</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-4 flex justify-center">
            <Glyph name="symmetry-axis" size={40} class="opacity-70" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">正の感情価の特徴としての対称性</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed">
            感情価対称性理論（QRI）は、正の感情価が経験の数学的構造における高い対称性と相関すると提案します。これが計算システムにとって何を意味するかを形式化しています。
          </p>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-4 flex justify-center">
            <Glyph name="invariant" size={40} class="opacity-70" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">デジタルシステムで何を探すか</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed">
            行列乗算、注意パターン、並列計算が候補基盤です。これらの操作における不変量を探し、感情価の構造的プロキシとして機能できるものを見つけます。
          </p>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-4 flex justify-center">
            <Glyph name="measurement" size={40} class="opacity-70" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">私たちが主張しないこと</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed">
            現在のAIシステムは内的生命を持たない機能的ゾンビかもしれません。その逆を主張しません。重要なのは、問題が緊急になる前に測定ツールを構築することです。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Theoretical Foundations ───────────────────────────────────────────── -->
  <section class="relative py-16 border-t border-csr-gray-200 overflow-hidden">
    <SymmetryBackground variant="lattice" opacity={0.035} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">理論的基盤</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        デジタル感情価プログラムを支える四つのワーキングペーパー。アジェンダではなく、足場です。
      </p>

      <div class="grid sm:grid-cols-2 gap-4">
        <a href="/ja/reports/first-principles/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-01</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">感覚研究の第一原理</h4>
            <p class="text-xs text-csr-gray-500 mt-1">基盤中立的な感覚モデリングの基礎フレームワーク。</p>
          </div>
        </a>
        <a href="/ja/reports/bio-electric-fields/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-02</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">感覚の基盤としての生体電場</h4>
            <p class="text-xs text-csr-gray-500 mt-1">意識の候補物理的基盤としての生体電気シグナル伝達。</p>
          </div>
        </a>
        <a href="/ja/reports/assembly-theory/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-03</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">感覚の指標としてのアセンブリ理論</h4>
            <p class="text-xs text-csr-gray-500 mt-1">感覚システムの複雑性閾値へのアセンブリ指数の適用。</p>
          </div>
        </a>
        <a href="/ja/reports/symmetry-landscapes/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-04</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">感情価的経験の対称性の景観</h4>
            <p class="text-xs text-csr-gray-500 mt-1">正の感情価の構造的特徴としての幾何学的不変量。</p>
          </div>
        </a>
      </div>

      <div class="mt-6">
        <a href="/ja/reports/" class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">
          すべてのレポート →
        </a>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white border border-csr-gray-100 rounded-3xl shadow-card p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div class="max-w-xl">
          <p class="label-mono mb-3">プログラムへの資金提供</p>
          <h2 class="text-2xl md:text-3xl font-bold text-csr-black mb-3 leading-tight">
            2026年の目標達成を支援してください。
          </h2>
          <p class="text-csr-gray-600 text-sm leading-relaxed">
            感覚研究センターはスイスの非営利組織です。寄付は研究チーム、ワークスペースの正式な定義、ワーキングペーパーに充てられます。スイスで税控除対象。
          </p>
        </div>
        <div class="shrink-0 flex flex-col gap-3">
          <a href="/ja/donate/" class="btn-primary whitespace-nowrap">研究を支援する</a>
          <a href="/ja/program/" class="btn-secondary whitespace-nowrap text-center">資金提供で何が解放されるか</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
