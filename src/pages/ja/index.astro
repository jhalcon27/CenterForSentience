--- 
const lang = Astro.currentLocale || 'en'; 
const prefix = lang === 'en' ? '' : `/${lang}`; 
import Layout from '../../layouts/Layout.astro';
---

<Layout title="研究アジェンダ" lang="ja">
  <!-- Hero Section -->
  <section class="py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(153,102,204,0.05),transparent_50%)]"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">
        <span class="text-gradient">意識のアーキテクチャ</span>をマッピングする
      </h1>
      <p class="text-lg text-csr-gray-600 max-w-2xl mx-auto leading-relaxed mb-8">
        意識研究センター（CSR）は、スイスに拠点を置く独立した非営利団体です。私たちは物理学、神経科学、哲学の架け橋となり、意識がどのようにすべての基質から生じるかを理解することを目指しています。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={prefix + "/research"} class="btn-primary px-6 py-3 bg-csr-primary text-white rounded-full font-semibold hover:bg-csr-primary-dark transition-all shadow-lg shadow-csr-primary/20">研究アジェンダ</a>
        <a href="#outputs" class="px-6 py-3 border border-gray-200 rounded-full font-semibold hover:bg-csr-gray-50 transition-all">白書</a>
      </div>
    </div>
  </section>

  <!-- Focus Areas -->
  <section class="py-12 border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-16">
        <h2 class="text-xs font-mono uppercase tracking-[0.3em] text-csr-primary mb-4">重点分野</h2>
        <p class="text-3xl font-bold">経験の地図を研究する</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 border border-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">生物学的インテリジェンス</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">形態学的インテリジェンス、細胞の意思決定、および非神経系における意識を研究します。</p>
          <a href={prefix + "/research#biological"} class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">詳細はこちら &rarr;</a>
        </div>
        <div class="p-8 border border-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">デジタル・マインド</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">組込み理論（Assembly Theory）によるデジタル意識の指標開発と、創発的システムのためのガバナンス評価。</p>
          <a href={prefix + "/research#digital"} class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">詳細はこちら &rarr;</a>
        </div>
        <div class="p-8 border border-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">クオリアの物理学</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">経験の幾何学、神経エントロピー、および価対称性を物理的不変量として形式化します。</p>
          <a href={prefix + "/research#qualia"} class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">詳細はこちら &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Outputs -->
  <section id="outputs" class="py-12 bg-csr-black text-white overflow-hidden relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
       <h2 class="text-xs font-mono uppercase tracking-[0.3em] text-csr-primary mb-12">ワーキングペーパー (WIP)</h2>
       <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
         <a href={prefix + "/reports/first-principles"} class="block p-6 border border-white/10 rounded-xl hover:border-csr-primary transition-all bg-white/5">
           <h4 class="text-lg font-bold mb-2">第一原理</h4>
           <p class="text-gray-400 text-xs">(WIP)</p>
         </a>
       </div>
    </div>
  </section>
</Layout>
