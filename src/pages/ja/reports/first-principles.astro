---
import Layout from '../../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="感性研究の第一原理" description="あらゆる基質にわたる意識をモデル化するための基礎フレームワーク。">
  <article class="py-12 max-w-4xl mx-auto px-4">
    <p class="text-[#9966CC] font-mono text-xs uppercase tracking-widest mb-4">基盤論文 — CSR-WP-01</p>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">感性研究の第一原理</h1>
    <div class="prose prose-slate">
      <p><em>現在作成中。</em></p>
    </div>
  </article>
</Layout>
