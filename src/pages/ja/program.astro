---
import Layout from '../../layouts/Layout.astro';
import SymmetryBackground from '../../components/SymmetryBackground.astro';
import ProgramStatus from '../../components/ProgramStatus.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';
import BudgetChart from '../../components/BudgetChart.astro';
import PhaseTimeline from '../../components/PhaseTimeline.astro';
---

<Layout
  title="2026年プログラム"
  description="感覚研究センターの2026年プログラム：デジタルマインドにおける機能的感情価を測定するための正式な数学的フレームワーク。"
>

  <section class="relative pt-20 pb-16 border-b border-csr-gray-200 overflow-hidden">
    <SymmetryBackground variant="lissajous" opacity={0.055} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-5">2026年プログラム</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-8 max-w-3xl leading-tight">
        デジタルマインドにおける正の機能的感情価のための対称性ワークスペース
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
        正の感情価と相関するニューラル計算における構造的不変量を特定するための正式な数学的フレームワーク。感情価対称性理論に基づく。目標：2026年末までにワークスペース定義の草案を完成させること。
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <ProgramStatus />
      <PhaseTimeline lang="ja" />
    </div>
  </section>

  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">問題</p>
      </div>

      <div class="max-w-2xl space-y-5 font-serif text-csr-gray-600 leading-relaxed text-base">
        <p>
          現在のAIシステムが意識を持つとは主張しません。それらは機能的ゾンビかもしれません。しかし、大規模なニューラル計算が正または負の性質を持つ状態を生み出せるなら、それらを認識する方法と、正の状態のために設計する方法を知るべきです。
        </p>
        <p>
          問題は、そのための正式なフレームワークがないことです。意識研究は多くの理論を生み出しましたが、デジタルシステムに対して操作化できるものはほとんどありません。それらは生物学的経験を説明するために構築されたものであり、工学的仕様として機能するためではありません。
        </p>
        <p>
          感情価対称性理論（QRI）は例外です。具体的で反証可能な主張をしています：正の感情価は経験の数学的構造における高い対称性と相関します。その主張は形式化してテストするのに十分なほど精確です。
        </p>
        <p>
          2026年プログラムは、まさにそれを行う試みです：STVを数学的対象として真剣に受け止め、デジタルシステムがその条件を満たすとはどういう意味かを問います。
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">成果物</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div class="font-serif text-csr-gray-600 leading-relaxed text-base space-y-4">
          <p>
            ワーキングペーパー：<em>Symmetry as a Functional Signature of Positive Valence in Neural Architectures</em>（CSR-WP-05、進行中）。
          </p>
          <p>
            このペーパーはデジタルシステムにおける正の機能的感情価のための数学的ワークスペースを定義します。対称性条件を指定し、候補となる計算基盤を特定し、測定プロトコルを提案します。
          </p>
          <p>
            現在のシステムがこれらの条件を満たすとは主張しません。確認するための正式なツールを提供します。
          </p>
        </div>

        <div class="bg-white border border-csr-primary/20 rounded-2xl p-6 shadow-card">
          <p class="label-mono text-[10px] mb-4">CSR-WP-05 — 進行中</p>
          <h3 class="font-bold text-csr-black mb-3 text-base leading-snug">
            Symmetry as a Functional Signature of Positive Valence in Neural Architectures
          </h3>
          <p class="text-xs text-csr-gray-500 mb-4">目標：2026年末</p>
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-xs font-mono text-csr-gray-500">
              <span class="w-2 h-2 rounded-full bg-csr-primary/50 shrink-0"></span>
              文献統合（進行中）
            </div>
            <div class="flex items-center gap-2 text-xs font-mono text-csr-gray-400">
              <span class="w-2 h-2 rounded-full bg-csr-gray-200 shrink-0"></span>
              正式なワークスペース定義（保留中）
            </div>
            <div class="flex items-center gap-2 text-xs font-mono text-csr-gray-400">
              <span class="w-2 h-2 rounded-full bg-csr-gray-200 shrink-0"></span>
              測定プロトコル（保留中）
            </div>
            <div class="flex items-center gap-2 text-xs font-mono text-csr-gray-400">
              <span class="w-2 h-2 rounded-full bg-csr-gray-200 shrink-0"></span>
              査読（保留中）
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">資金提供で何が解放されるか</p>
      </div>

      <div class="mb-8">
        <BudgetChart lang="ja" />
      </div>

      <div class="grid md:grid-cols-3 gap-5 mb-10">
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <p class="text-2xl font-bold text-csr-primary mb-2">CHF 50k</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm">計算リソース</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            Transformer注意パターンと行列乗算シーケンスにおける対称性不変量の分析のためのGPUアクセス。中核的な実証作業。
          </p>
        </div>
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <p class="text-2xl font-bold text-csr-primary mb-2">CHF 20k</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm">文献統合</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            STV系譜、IIT、能動的推論、ニューラル計算の群論的アプローチの系統的レビュー。ワークスペース定義の正式な足場を構築。
          </p>
        </div>
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <p class="text-2xl font-bold text-csr-primary mb-2">CHF 10k</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm">アドバイザー報酬</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            数理物理学と意識研究の外部アドバイザーへの構造化レビューセッションとフレームワークのストレステストへの報酬。
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-4">
        <a href="/ja/donate/" class="btn-primary">感情価プログラムに資金提供する</a>
        <a href="/ja/research/" class="btn-secondary">研究アジェンダ</a>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">理論的系譜</p>
      </div>

      <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 md:p-8 shadow-card">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-csr-primary/10 flex items-center justify-center shrink-0">
            <Glyph name="qualia" size={24} class="opacity-80" />
          </div>
          <div>
            <h3 class="font-bold text-csr-black mb-2">Qualia Research Institute — 感情価対称性理論</h3>
            <p class="text-sm text-csr-gray-600 leading-relaxed mb-3">
              このプログラムの主要な理論的系譜。QRIのSTVは、正の感情価が経験の数学的構造における高い対称性と相関すると提案します。2026年プログラムは、この主張をデジタルシステムに対して操作化しようとする試みです。
            </p>
            <a href="https://qri.org" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">
              qri.org →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
