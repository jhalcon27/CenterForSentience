---
import Layout from '../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="ミッションの支援" description="税控除対象となる寄付や戦略的パートナーシップを通じて、意識研究センター（CSR）をご支援ください。">
  <section class="py-12 bg-[#FFF8F0]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-[#9966CC] font-mono text-xs uppercase tracking-widest mb-4">戦略的支援</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        <span class="text-gradient">インパクトの大きい研究</span>のためのパートナーシップ
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        意識研究センター（CSR）は、意識という困難な問題の解決に取り組む先見の明のある人々、慈善家、研究機関のコミュニティによって支えられています。
      </p>
    </div>
  </section>
</Layout>
