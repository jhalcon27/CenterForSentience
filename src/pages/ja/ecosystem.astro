---
import Layout from '../../layouts/Layout.astro';

const institutes = [
  {
    name: "Qualia Research Institute (QRI)",
    description: "意識体験の数学的構造の解明を目的とした非営利団体。",
    link: "https://qri.org",
    tag: "非営利団体"
  },
  {
    name: "Levin Lab",
    description: "タフツ大学のマイケル・レビン教授が率いる。生体電気、再生医療、合成形態学の研究を行っている。",
    link: "https://www.drmichaellevin.org",
    tag: "研究室"
  },
  {
    name: "Cronin Group",
    description: "グラスゴー大学のリー・クローニン教授が率いる。生命の起源とアセンブリー理論（Assembly Theory）を追求している。",
    link: "https://www.chem.gla.ac.uk/cronin/",
    tag: "研究室"
  },
  {
    name: "Robin Carhart-Harris",
    description: "UCSF Neuroscape サイケデリック部門の創設ディレクター。脳におけるサイケデリックの作用機序に焦点を当てている。",
    link: "https://profiles.ucsf.edu/robin.carhart-harris",
    tag: "研究"
  },
  {
    name: "Sentience Institute",
    description: "人類の道徳の範囲を拡大するための最も効果的な戦略を研究する学際的なシンクタンク。",
    link: "https://www.sentienceinstitute.org",
    tag: "シンクタンク"
  }
];
---

<Layout 
  title="エコシステム" 
  description="意識の物理的基礎研究と道徳の範囲の拡大に取り組む提携組織および研究機関。"
>
  <!-- Header -->
  <section class="py-20 border-b border-csr-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-csr-primary font-mono text-xs uppercase tracking-widest mb-4">エコシステム</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        研究<span class="text-gradient">ネットワーク</span>
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed">
        CSRは、心の性質と感覚の物理的基礎の理解に取り組む研究者、研究室、非営利団体からなる広範なエコシステムの中で活動しています。
      </p>
    </div>
  </section>

  <!-- Institutes Grid -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {institutes.map((inst) => (
          <a 
            href={inst.link} 
            target="_blank" 
            rel="noopener noreferrer"
            class="group p-8 bg-white border border-gray-100 rounded-3xl hover:border-[#9966CC]/30 hover:shadow-xl hover:shadow-[#9966CC]/5 transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div class="flex justify-between items-start mb-4">
                <span class="text-[10px] font-mono uppercase tracking-wider text-[#9966CC] bg-[#9966CC]/5 px-2 py-1 rounded">
                  {inst.tag}
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-300 group-hover:text-[#9966CC] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <h3 class="text-xl font-bold mb-3 group-hover:text-[#9966CC] transition-colors">{inst.name}</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-6">
                {inst.description}
              </p>
            </div>
            <div class="text-[#9966CC] text-sm font-medium flex items-center gap-1 group-hover:gap-2 transition-all">
              ウェブサイトを見る
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Collaboration CTA -->
  <section class="py-20 bg-csr-gray-50 border-t border-csr-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold mb-4">ネットワークの拡大</h2>
      <p class="text-csr-gray-600 mb-8">私たちは常に、意識科学の限界を押し広げる組織や研究者との連携を求めています。</p>
      <a href="/ja/contact" class="inline-block bg-[#9966CC] text-white px-8 py-4 rounded-full font-semibold hover:bg-[#8055ab] transition-all">追加を提案する</a>
    </div>
  </section>
</Layout>
