---
import Layout from '../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="研究アジェンダ" description="意識の物理的基盤を調査するための3つの核心的柱。">
  <section class="py-12 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-csr-primary font-mono text-xs uppercase tracking-widest mb-4">研究アジェンダ</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        <span class="text-gradient">意識のアーキテクチャ</span>をマッピングする
      </h1>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href={prefix + "/contact"} class="btn-primary px-8 py-4 bg-csr-primary text-white rounded-full font-semibold hover:bg-csr-primary-dark transition-all">連絡を取る</a>
    </div>
  </section>
</Layout>
