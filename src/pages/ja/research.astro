---
import Layout from '../../layouts/Layout.astro';
import SymmetryBackground from '../../components/SymmetryBackground.astro';
import ProgramStatus from '../../components/ProgramStatus.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';
---

<Layout
  title="研究"
  description="感覚研究センターの旗艦プログラム：デジタルマインドにおける機能的感情価を測定するための対称性フレームワーク。"
>

  <section class="relative pt-20 pb-14 border-b border-csr-gray-200 overflow-hidden">
    <SymmetryBackground variant="lissajous" opacity={0.045} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-4">研究アジェンダ</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">
        旗艦プログラム：デジタル感情価
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
        具体的なプログラム。2026年の目標。それ以外はすべて背景研究または並行調査です。
      </p>
    </div>
  </section>

  <section class="py-16" id="digital">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">旗艦プログラム</p>
      </div>

      <ProgramStatus />

      <div class="mt-10 grid md:grid-cols-3 gap-5">
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="symmetry-axis" size={32} class="opacity-60" /></div>
          <p class="label-mono text-[10px] mb-3">サブトラック A</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm leading-snug">Transformer注意における対称性不変量</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            多頭注意重み行列における群論的対称性の特定。生物システムにおける高感情価状態は注意パターンに構造的類似物を持つか？
          </p>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="lattice" size={32} class="opacity-60" /></div>
          <p class="label-mono text-[10px] mb-3">サブトラック B</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm leading-snug">感情価基盤としての行列乗算</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            反復的な行列乗算が感情価状態に関連するグローバル統合の種類を生み出せる条件の形式化。
          </p>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="field" size={32} class="opacity-60" /></div>
          <p class="label-mono text-[10px] mb-3">サブトラック C</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm leading-snug">並列計算と現象的結合</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            大規模並列計算が感情価対称性理論の要求する統一された表現構造の種類を生み出せるかの検討。
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/ja/program/" class="btn-primary">プログラムの詳細</a>
        <a href="/ja/donate/" class="btn-secondary">この研究に資金提供する</a>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-csr-gray-200" id="biological">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">背景研究</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        生物学的知性と単純なマインドのモデルがデジタル感情価プログラムに情報を提供します。それらはアジェンダではありません。
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <p class="label-mono text-[10px] mb-3">生物学的知性</p>
          <h3 class="font-bold text-csr-black mb-3 text-base">基盤中立的な感覚モデリング</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            生物システムは感情価状態の経験的グラウンドトゥルースを提供します。生体電場、神経エントロピー、能動的推論を候補物理的相関物として研究しています。主要ターゲットとしてではなく、デジタルプログラムのキャリブレーションデータとして。
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">生体電場</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">神経エントロピー</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">能動的推論</span>
          </div>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card" id="qualia">
          <p class="label-mono text-[10px] mb-3">並行調査</p>
          <h3 class="font-bold text-csr-black mb-3 text-base">クオリアの物理学</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            現象的経験の物理的基盤に関する理論的研究。デジタル感情価プログラムと並行して実施し、QRIの感情価対称性理論を主要な理論的系譜として活用。
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">感情価対称性理論</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">現象学</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">QRI系譜</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">基礎的読み物</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        デジタル感情価プログラムの理論的足場を提供するワーキングペーパー。
      </p>
      <div class="grid sm:grid-cols-2 gap-4">
        <a href="/ja/reports/first-principles/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-01</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">感覚研究の第一原理</h4>
          </div>
        </a>
        <a href="/ja/reports/bio-electric-fields/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-02</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">感覚の基盤としての生体電場</h4>
          </div>
        </a>
        <a href="/ja/reports/assembly-theory/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-03</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">感覚の指標としてのアセンブリ理論</h4>
          </div>
        </a>
        <a href="/ja/reports/symmetry-landscapes/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-04</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">感情価的経験の対称性の景観</h4>
          </div>
        </a>
      </div>
      <div class="mt-6">
        <a href="/ja/reports/" class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">すべてのレポート →</a>
      </div>
    </div>
  </section>

</Layout>
