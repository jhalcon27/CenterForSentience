---
import Layout from '../layouts/Layout.astro';
import ContactContent from '../components/ContactContent.astro';

const t = {
  label: 'Contact',
  headingStart: "Let's",
  headingAccent: 'connect',
  intro: 'We are open to research collaborations, philanthropic partnerships, and strategic dialogue. Reach out via the form below.',
  name: 'Name',
  email: 'Email',
  inquiryType: 'Inquiry Type',
  optResearch: 'Research Collaboration',
  optPartnership: 'Philanthropic Partnership',
  optOther: 'General Inquiry',
  message: 'Message',
  send: 'Send Message',
  sending: 'Sending…',
  success: "Message sent — we'll get back to you soon.",
  error: 'Something went wrong. Please try again or email us directly.',
  orEmail: 'Or email directly:',
};
---

<Layout
  title="Contact"
  description="Connect with the Center for Sentience Research."
>
  <ContactContent t={t} />
</Layout>
