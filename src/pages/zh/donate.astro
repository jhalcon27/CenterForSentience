---
import Layout from '../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="支持我们的使命" description="通过免税捐赠和战略合作伙伴关系支持意识研究中心（CSR）。">
  <section class="py-12 bg-[#FFF8F0]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-[#9966CC] font-mono text-xs uppercase tracking-widest mb-4">战略支持</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        建立 <span class="text-gradient">高影响力研究</span> 的合作伙伴关系
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        意识研究中心（CSR）得到了致力于解决意识这一难题的远见者、慈善家和研究机构的支持。
      </p>
    </div>
  </section>
</Layout>
