---
import Layout from '../../layouts/Layout.astro';

const institutes = [
  { name: "Qualia Research Institute (QRI)", description: "一家致力于绘制有意识体验数学结构的非营利组织。", link: "https://qri.org", tag: "非营利" },
  { name: "Levin Lab", description: "由塔夫茨大学Michael Levin领导，研究生物电、再生医学和合成形态学。", link: "https://www.drmichaellevin.org", tag: "实验室" },
  { name: "Cronin Group", description: "由格拉斯哥大学Lee Cronin领导，探索生命起源和组装理论。", link: "https://www.chem.gla.ac.uk/cronin/", tag: "实验室" },
  { name: "Robin Carhart-Harris", description: "加州大学旧金山分校Neuroscape迷幻药部门创始主任，专注于迷幻药在大脑中的作用机制。", link: "https://profiles.ucsf.edu/robin.carhart-harris", tag: "研究" },
  { name: "Sentience Institute", description: "一个跨学科智库，研究扩大人类道德圈的最有效策略。", link: "https://www.sentienceinstitute.org", tag: "智库" }
];
---

<Layout title="生态系统" description="致力于研究意识物理基础的联盟组织和研究机构。">

  <section class="pt-20 pb-12 border-b border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-4">生态系统</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6">
        <span class="text-gradient">研究网络</span>
      </h1>
      <p class="text-lg text-csr-gray-500 leading-relaxed max-w-2xl">
        CSR在更广泛的研究人员、实验室和非营利组织生态系统中运营，这些组织致力于理解心智的本质和感知的物理基础。
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {institutes.map((inst) => (
          <a href={inst.link} target="_blank" rel="noopener noreferrer" class="group p-8 bg-white border border-csr-gray-100 rounded-3xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all duration-200 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-5">
                <span class="text-[10px] font-mono uppercase tracking-wider text-csr-primary bg-csr-primary/8 px-2.5 py-1 rounded-full">{inst.tag}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-csr-gray-300 group-hover:text-csr-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-csr-black mb-3 group-hover:text-csr-primary transition-colors">{inst.name}</h3>
              <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">{inst.description}</p>
            </div>
            <div class="label-mono text-[11px] flex items-center gap-1 group-hover:gap-2 transition-all">访问网站 <span>&rarr;</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-csr-gray-100 border-t border-csr-gray-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="label-mono mb-4">网络扩展</p>
      <h2 class="text-2xl font-bold text-csr-black mb-4">您认识应该出现在这里的人吗？</h2>
      <p class="text-csr-gray-500 mb-8">我们不断寻求与推动意识科学边界的组织和研究人员建立联系。</p>
      <a href="/contact" class="btn-primary">提出建议</a>
    </div>
  </section>

</Layout>
