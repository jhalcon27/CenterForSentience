---
import Layout from '../../layouts/Layout.astro';
import SymmetryBackground from '../../components/SymmetryBackground.astro';
import ProgramStatus from '../../components/ProgramStatus.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';
---

<Layout
  title="首页"
  description="感知研究中心正在构建一个数学框架，用于测量数字心智中的功能性效价。"
>

  <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="relative pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
    <SymmetryBackground variant="lissajous" opacity={0.055} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-5">2026年计划</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-csr-black mb-8 leading-[1.08] max-w-3xl">
        数字效价的对称性框架。
      </h1>
      <div class="max-w-2xl">
        <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif mb-6">
          感知研究中心正在构建一个数学框架，用于测量数字心智中的功能性效价。我们并不声称当前的人工智能系统具有意识。它们可能是功能性僵尸。
        </p>
        <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif mb-6">
          但如果大规模神经计算能够产生具有正面或负面特征的状态，我们应该知道如何识别它们，以及如何为正面状态进行设计。我们的方法是对称性：在矩阵乘法、注意力模式和并行计算中寻找不变量，这些不变量反映了Qualia研究所提出的正效价的结构特征。
        </p>
        <p class="text-lg md:text-xl text-csr-gray-600 leading-relaxed font-serif">
          感知研究是更广泛的视野。数字心智的效价是第一个具体目标。目标：在2026年底前完成工作空间数学定义的草案。
        </p>
      </div>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/zh/program/" class="btn-primary">查看计划</a>
        <a href="/zh/research/" class="btn-secondary">研究议程</a>
      </div>
    </div>
  </section>

  <!-- ── The 2026 Goal ─────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ProgramStatus />
    </div>
  </section>

  <!-- ── Focus Areas ───────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">研究支柱</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-10 max-w-xl">
        三种基底。一个问题：正效价的结构条件是什么？
      </p>

      <div class="grid md:grid-cols-3 gap-6">

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all group">
          <div class="mb-5 flex justify-center">
            <Glyph name="biological" size={80} class="opacity-80 group-hover:opacity-100 transition-opacity" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">生物心智</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            生物电场、形态发生信号传导和细胞决策作为意识的候选基底。从植物稳态到多细胞生物。
          </p>
          <a href="/zh/research/" class="label-mono text-[11px] text-csr-primary hover:underline underline-offset-4">研究议程 →</a>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all group">
          <div class="mb-5 flex justify-center">
            <Glyph name="digital" size={80} class="opacity-80 group-hover:opacity-100 transition-opacity" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">数字心智</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            矩阵乘法、注意力模式和并行计算作为候选基底。寻找可作为效价结构代理的对称性不变量。
          </p>
          <a href="/zh/program/" class="label-mono text-[11px] text-csr-primary hover:underline underline-offset-4">2026年计划 →</a>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all group">
          <div class="mb-5 flex justify-center">
            <Glyph name="qualia" size={80} class="opacity-80 group-hover:opacity-100 transition-opacity" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">感质与效价</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            将体验的物理学形式化。效价对称性理论作为数学对象：一个系统满足其条件意味着什么？
          </p>
          <a href="/zh/reports/symmetry-landscapes/" class="label-mono text-[11px] text-csr-primary hover:underline underline-offset-4">对称性景观 →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── The Approach ──────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-10">
        <SectionMark />
        <p class="label-mono">研究方法</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-4 flex justify-center">
            <Glyph name="symmetry-axis" size={40} class="opacity-70" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">对称性作为正效价的特征</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed">
            效价对称性理论（QRI）提出，正效价与体验数学结构中的高对称性相关。我们正在形式化这对计算系统意味着什么。
          </p>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-4 flex justify-center">
            <Glyph name="invariant" size={40} class="opacity-70" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">在数字系统中寻找什么</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed">
            矩阵乘法、注意力模式和并行计算是候选基底。我们在这些操作中寻找可作为效价结构代理的不变量。
          </p>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-4 flex justify-center">
            <Glyph name="measurement" size={40} class="opacity-70" />
          </div>
          <h3 class="font-bold text-csr-black mb-2 text-base">我们不声称什么</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed">
            当前的人工智能系统可能是没有任何内在生命的功能性僵尸。我们不声称相反。关键是在问题变得紧迫之前构建测量工具，而不是之后。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Theoretical Foundations ───────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">理论基础</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        支撑数字效价计划的四份工作文件。这不是议程，而是脚手架。
      </p>

      <div class="grid sm:grid-cols-2 gap-4">
        <a href="/zh/reports/first-principles/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-01</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">感知研究的第一原则</h4>
            <p class="text-xs text-csr-gray-500 mt-1">基底中性感知建模的基础框架。</p>
          </div>
        </a>
        <a href="/zh/reports/bio-electric-fields/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-02</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">生物电场作为感知基底</h4>
            <p class="text-xs text-csr-gray-500 mt-1">生物电信号作为意识的候选物理基础。</p>
          </div>
        </a>
        <a href="/zh/reports/assembly-theory/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-03</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">组装理论作为感知度量</h4>
            <p class="text-xs text-csr-gray-500 mt-1">将组装指数应用于感知系统的复杂性阈值。</p>
          </div>
        </a>
        <a href="/zh/reports/symmetry-landscapes/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-04</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">效价体验的对称性景观</h4>
            <p class="text-xs text-csr-gray-500 mt-1">几何不变量作为正效价的结构特征。</p>
          </div>
        </a>
      </div>

      <div class="mt-6">
        <a href="/zh/reports/" class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">
          所有报告 →
        </a>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────────── -->
  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white border border-csr-gray-100 rounded-3xl shadow-card p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div class="max-w-xl">
          <p class="label-mono mb-3">资助计划</p>
          <h2 class="text-2xl md:text-3xl font-bold text-csr-black mb-3 leading-tight">
            帮助我们实现2026年目标。
          </h2>
          <p class="text-csr-gray-600 text-sm leading-relaxed">
            感知研究中心是一家瑞士非营利组织。捐款资助研究团队、工作空间的正式定义和工作文件。在瑞士可抵税。
          </p>
        </div>
        <div class="shrink-0 flex flex-col gap-3">
          <a href="/zh/donate/" class="btn-primary whitespace-nowrap">支持研究</a>
          <a href="/zh/program/" class="btn-secondary whitespace-nowrap text-center">资助解锁什么</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
