--- 
const lang = Astro.currentLocale || 'en'; 
const prefix = lang === 'en' ? '' : `/${lang}`; 
import Layout from '../../layouts/Layout.astro';
---

<Layout title="研究议程" lang="zh">
  <!-- Hero Section -->
  <section class="py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(153,102,204,0.05),transparent_50%)]"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">绘制 <span class="text-gradient">意识的架构图</span></h1>
      <p class="text-lg text-csr-gray-600 max-w-2xl mx-auto leading-relaxed mb-8">
        意识研究中心（CSR）是位于瑞士的一家独立非营利机构。我们架起了物理学、神经科学和哲学之间的桥梁，以了解意识如何跨越所有基质产生。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={prefix + "/research"} class="btn-primary px-6 py-3 bg-csr-primary text-white rounded-full font-semibold hover:bg-csr-primary-dark transition-all shadow-lg shadow-csr-primary/20">研究议程</a>
        <a href="#outputs" class="px-6 py-3 border border-gray-200 rounded-full font-semibold hover:bg-csr-gray-50 transition-all">白皮书</a>
      </div>
    </div>
  </section>

  <!-- Focus Areas -->
  <section class="py-12 border-t border-csr-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-16">
        <h2 class="text-xs font-mono uppercase tracking-[0.3em] text-csr-primary mb-4">重点领域</h2>
        <p class="text-3xl font-bold">研究经验之图</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 border border-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">生物智能</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">研究形态智能、细胞决策制定以及非神经系统中的意识。</p>
          <a href={prefix + "/research#biological"} class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">了解更多 &rarr;</a>
        </div>
        <div class="p-8 border border-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">数字思维</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">通过组装理论开发数字感官指标，并评估新兴系统的治理框架。</p>
          <a href={prefix + "/research#digital"} class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">了解更多 &rarr;</a>
        </div>
        <div class="p-8 border border-gray-100 rounded-2xl hover:border-csr-primary/30 transition-all">
          <h3 class="text-xl font-bold mb-4">感官物理学</h3>
          <p class="text-csr-gray-600 text-sm leading-relaxed mb-6">将经验几何、神经熵和价对称性形式化为物理不变量。</p>
          <a href={prefix + "/research#qualia"} class="text-csr-primary text-xs font-bold uppercase tracking-widest hover:underline">了解更多 &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Outputs -->
  <section id="outputs" class="py-12 bg-csr-black text-white overflow-hidden relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
       <h2 class="text-xs font-mono uppercase tracking-[0.3em] text-csr-primary mb-12">工作论文 (WIP)</h2>
       <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
         <a href={prefix + "/reports/first-principles"} class="block p-6 border border-white/10 rounded-xl hover:border-csr-primary transition-all bg-white/5">
           <h4 class="text-lg font-bold mb-2">基本原则</h4>
           <p class="text-gray-400 text-xs">(WIP)</p>
         </a>
       </div>
    </div>
  </section>
</Layout>
