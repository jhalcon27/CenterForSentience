---
import Layout from '../../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="感知的基本原则" description="建模跨所有基质意识的基础框架。">
  <article class="py-12 max-w-4xl mx-auto px-4">
    <p class="text-[#9966CC] font-mono text-xs uppercase tracking-widest mb-4">基础论文 — CSR-WP-01</p>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">感知的基本原则</h1>
    <div class="prose prose-slate">
      <p><em>内容开发中。</em></p>
    </div>
  </article>
</Layout>
