---
import Layout from '../../layouts/Layout.astro';
import SymmetryBackground from '../../components/SymmetryBackground.astro';
import ProgramStatus from '../../components/ProgramStatus.astro';
import SectionMark from '../../components/SectionMark.astro';
import Glyph from '../../components/Glyph.astro';
---

<Layout
  title="研究"
  description="感知研究中心的旗舰计划：用于测量数字心智中功能性效价的对称性框架。"
>

  <section class="relative pt-20 pb-14 border-b border-csr-gray-200 overflow-hidden">
    <SymmetryBackground variant="lissajous" opacity={0.045} />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-mono mb-4">研究议程</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-csr-black mb-6 max-w-2xl leading-tight">
        旗舰计划：数字效价
      </h1>
      <p class="text-lg text-csr-gray-600 leading-relaxed max-w-2xl font-serif">
        一个具体计划。一个2026年目标。其余一切都是背景研究或平行探究。
      </p>
    </div>
  </section>

  <section class="py-16" id="digital">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <SectionMark />
        <p class="label-mono">旗舰计划</p>
      </div>

      <ProgramStatus />

      <div class="mt-10 grid md:grid-cols-3 gap-5">
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="symmetry-axis" size={32} class="opacity-60" /></div>
          <p class="label-mono text-[10px] mb-3">子轨道 A</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm leading-snug">Transformer注意力中的对称性不变量</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            识别多头注意力权重矩阵中的群论对称性。生物系统中的高效价状态在注意力模式中是否有结构类比？
          </p>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="lattice" size={32} class="opacity-60" /></div>
          <p class="label-mono text-[10px] mb-3">子轨道 B</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm leading-snug">矩阵乘法作为效价基底</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            形式化重复矩阵乘法可能产生与效价状态相关的全局整合类型的条件。
          </p>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <div class="mb-3 flex justify-center"><Glyph name="field" size={32} class="opacity-60" /></div>
          <p class="label-mono text-[10px] mb-3">子轨道 C</p>
          <h3 class="font-bold text-csr-black mb-2 text-sm leading-snug">并行计算与现象绑定</h3>
          <p class="text-xs text-csr-gray-600 leading-relaxed">
            检验大规模并行计算是否能产生效价对称性理论所要求的统一表征结构类型。
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/zh/program/" class="btn-primary">完整计划详情</a>
        <a href="/zh/donate/" class="btn-secondary">资助这项工作</a>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-csr-gray-200" id="biological">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">背景研究</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        生物智能和简单心智模型为数字效价计划提供信息。它们不是议程。
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card">
          <p class="label-mono text-[10px] mb-3">生物智能</p>
          <h3 class="font-bold text-csr-black mb-3 text-base">基底中性感知建模</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            生物系统为效价状态提供经验基准真相。我们研究生物电场、神经熵和主动推断作为候选物理相关物，不是作为主要目标，而是作为数字计划的校准数据。
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">生物电场</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">神经熵</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">主动推断</span>
          </div>
        </div>

        <div class="bg-white border border-csr-gray-100 rounded-2xl p-6 shadow-card" id="qualia">
          <p class="label-mono text-[10px] mb-3">平行探究</p>
          <h3 class="font-bold text-csr-black mb-3 text-base">感质物理学</h3>
          <p class="text-sm text-csr-gray-600 leading-relaxed mb-4">
            关于现象体验物理基础的理论工作。与数字效价计划并行进行，依托QRI的效价对称性理论作为主要理论谱系。
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">效价对称性理论</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">现象学</span>
            <span class="px-2 py-1 bg-csr-gray-100 text-csr-gray-600 text-xs font-mono rounded-lg">QRI谱系</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-csr-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3">
        <SectionMark />
        <p class="label-mono">基础阅读</p>
      </div>
      <p class="text-csr-gray-500 text-sm mb-8 max-w-xl">
        为数字效价计划提供理论框架的工作文件。
      </p>
      <div class="grid sm:grid-cols-2 gap-4">
        <a href="/zh/reports/first-principles/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-01</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">感知研究的第一原则</h4>
          </div>
        </a>
        <a href="/zh/reports/bio-electric-fields/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-02</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">生物电场作为感知基底</h4>
          </div>
        </a>
        <a href="/zh/reports/assembly-theory/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-03</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">组装理论作为感知度量</h4>
          </div>
        </a>
        <a href="/zh/reports/symmetry-landscapes/" class="group flex gap-4 p-5 bg-white border border-csr-gray-100 rounded-2xl shadow-card hover:border-csr-primary/30 hover:shadow-soft transition-all">
          <span class="label-mono text-[10px] shrink-0 mt-0.5">CSR-WP-04</span>
          <div>
            <h4 class="font-semibold text-csr-black text-sm group-hover:text-csr-primary transition-colors leading-snug">效价体验的对称性景观</h4>
          </div>
        </a>
      </div>
      <div class="mt-6">
        <a href="/zh/reports/" class="text-sm font-medium text-csr-primary hover:text-csr-primary-dark transition-colors">所有报告 →</a>
      </div>
    </div>
  </section>

</Layout>
