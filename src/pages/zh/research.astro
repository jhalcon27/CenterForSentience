---
import Layout from '../../layouts/Layout.astro';
const lang = Astro.currentLocale || 'en';
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="研究议程" description="我们探索意识物理基础的三个核心支柱。">
  <section class="py-12 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-csr-primary font-mono text-xs uppercase tracking-widest mb-4">研究议程</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        绘制 <span class="text-gradient">意识的架构图</span>
      </h1>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href={prefix + "/contact"} class="btn-primary px-8 py-4 bg-csr-primary text-white rounded-full font-semibold hover:bg-csr-primary-dark transition-all">联系我们</a>
    </div>
  </section>
</Layout>
