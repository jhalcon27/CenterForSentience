--- 
const lang = Astro.currentLocale || 'en'; 
const prefix = lang === 'en' ? '' : `/${lang}`; 
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Research Agenda" 
  description="The three core pillars of our investigation into the physical foundations of sentience: biological, digital, and theoretical."
>
  <!-- Research Header -->
  <section class="py-12 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-csr-primary font-mono text-xs uppercase tracking-widest mb-4">Research Agenda</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">
        Mapping the <span class="text-gradient">continuum of awareness</span>
      </h1>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href={prefix + "/contact"} class="btn-primary px-8 py-4 bg-csr-primary text-white rounded-full font-semibold hover:bg-csr-primary-dark transition-all">Get in Touch</a>
    </div>
  </section>
</Layout>
